<UserControl x:Class="Inmobiliaria.Desktop.Views.ContractActionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:leasing="clr-namespace:Inmobiliaria.Domain.Leasing;assembly=Inmobiliaria.Domain"
             xmlns:contracts="clr-namespace:Inmobiliaria.Presentation.Contracts;assembly=Inmobiliaria.Presentation"
             xmlns:views="clr-namespace:Inmobiliaria.Desktop.Views"
             mc:Ignorable="d"
             d:DesignHeight="785" d:DesignWidth="1268">
    <!--
        The contract's actions with their own screen, as the designer drew them (canvas "ContratoAviso", "ContratoDeshacerAviso",
        1536 x 785), in place of the detail while one is open: the title of the action open, the contract it is for, the action's
        own form, then its summary to confirm, then the notice of what it did. Which action is the view-model's OpenAction; each
        step is the view-model's too (the fields' errors, PendingChange, Done). Bound to the open contract's
        ContractDetailViewModel; no logic lives here. Cards at most 900 wide, as on the canvas.
    -->
    <UserControl.Resources>
        <views:SetToVisibleConverter x:Key="Set" />
        <views:EqualsConverter x:Key="Equals" />
        <BooleanToVisibilityConverter x:Key="Shown" />

        <!-- One line of a card, the canvas's "kv": what it is, muted, and its value, bold. -->
        <DataTemplate x:Key="Line">
            <DockPanel Margin="0,6">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="Bold" />
                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Theme.Muted}" />
            </DockPanel>
        </DataTemplate>

        <Style x:Key="LargeGhost" TargetType="Button" BasedOn="{StaticResource Theme.GhostButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="26,0" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="LargePrimary" TargetType="Button" BasedOn="{StaticResource Theme.PrimaryButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="26,0" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="Required" TargetType="Run">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Bad}" />
        </Style>

        <!-- Each action's form, shown until its summary opens or it lands; each action's summary while it is open. -->
        <Style x:Key="NoticeForm" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding OpenAction}" Value="{x:Static contracts:ContractAction.Notice}" />
                        <Condition Binding="{Binding IsSummaryOpen}" Value="False" />
                        <Condition Binding="{Binding Done}" Value="{x:Null}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NoticeSummary" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding OpenAction}" Value="{x:Static contracts:ContractAction.Notice}" />
                        <Condition Binding="{Binding IsSummaryOpen}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UndoNoticeForm" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding OpenAction}" Value="{x:Static contracts:ContractAction.UndoNotice}" />
                        <Condition Binding="{Binding IsSummaryOpen}" Value="False" />
                        <Condition Binding="{Binding Done}" Value="{x:Null}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UndoNoticeSummary" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding OpenAction}" Value="{x:Static contracts:ContractAction.UndoNotice}" />
                        <Condition Binding="{Binding IsSummaryOpen}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EndForm" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding OpenAction}" Value="{x:Static contracts:ContractAction.End}" />
                        <Condition Binding="{Binding IsSummaryOpen}" Value="False" />
                        <Condition Binding="{Binding Done}" Value="{x:Null}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EndSummary" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding OpenAction}" Value="{x:Static contracts:ContractAction.End}" />
                        <Condition Binding="{Binding IsSummaryOpen}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The canvas's textarea: the input's box, taller, the text from the top. -->
        <Style x:Key="TextArea" TargetType="TextBox" BasedOn="{StaticResource Theme.Input}">
            <Setter Property="Height" Value="96" />
            <Setter Property="AcceptsReturn" Value="True" />
            <!-- Theme.Input centres its text; a tall box writes from the top. -->
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" CornerRadius="16" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid Margin="0,10">
                                <Border Padding="{TemplateBinding Padding}" IsHitTestVisible="False">
                                    <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" VerticalAlignment="Top" Margin="2,0,0,0"
                                               Foreground="{DynamicResource Theme.Muted}" Visibility="Collapsed" />
                                </Border>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Stretch" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Theme.Ink2}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Theme.Focus}" />
                                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="views:FieldError.HasError" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Theme.Bad}" />
                                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- The title and subtitle of the action open. -->
            <TextBlock>
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Theme.Title}">
                        <Setter Property="Text" Value="Registrar aviso" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OpenAction}" Value="{x:Static contracts:ContractAction.UndoNotice}">
                                <Setter Property="Text" Value="Deshacer aviso" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OpenAction}" Value="{x:Static contracts:ContractAction.End}">
                                <Setter Property="Text" Value="Terminar contrato" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock>
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Theme.Subtitle}">
                        <Setter Property="Text" Value="El inquilino avisó que se va. El contrato sigue corriendo hasta que usted lo termine." />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OpenAction}" Value="{x:Static contracts:ContractAction.UndoNotice}">
                                <Setter Property="Text" Value="Saca el aviso de rescisión y el contrato vuelve a estar activo. Queda anotado quién lo hizo y por qué." />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OpenAction}" Value="{x:Static contracts:ContractAction.End}">
                                <Setter Property="Text" Value="El contrato deja de generar períodos desde la fecha de fin. Lo que se debe queda en la cuenta." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- The back link of every screen: a small ghost button with its chevron, under the title on the left. -->
            <Button Style="{StaticResource Theme.SmallGhostButton}" Padding="10,0,14,0" HorizontalAlignment="Left"
                    Margin="0,12,0,0" Command="{Binding CloseActionCommand}">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                        <Canvas Width="24" Height="24">
                            <Path Data="M15,6 L9,12 L15,18" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Volver al contrato" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Text="{Binding Runner.ErrorMessage}" Style="{StaticResource Theme.ErrorText}" Margin="0,12,0,0" />
            <TextBlock Text="{Binding RefusalMessage}" Style="{StaticResource Theme.ErrorText}" Margin="0,12,0,0" />

            <!-- The contract it is for, with its state. -->
            <Border Style="{StaticResource Theme.Card}" MaxWidth="900" HorizontalAlignment="Left" Width="900" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <!-- Coloured as on the list and the detail: green in force, amber with notice. -->
                        <Border DockPanel.Dock="Right" Margin="0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Theme.Chip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Detail.Status}" Value="{x:Static leasing:ContractStatus.Active}">
                                            <Setter Property="Tag" Value="ok" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Detail.Status}" Value="{x:Static leasing:ContractStatus.PendingTermination}">
                                            <Setter Property="Tag" Value="warn" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusText}" />
                        </Border>
                        <TextBlock Text="Contrato" Style="{StaticResource Theme.CardTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ActionCardLines}" ItemTemplate="{StaticResource Line}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Registrar aviso, step 1: the two dates, each with its error under it. -->
            <StackPanel Style="{StaticResource NoticeForm}">
                <Border Style="{StaticResource Theme.Card}" Width="900" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Fechas del aviso" Style="{StaticResource Theme.CardTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Width="220">
                                <TextBlock Style="{StaticResource Theme.Label}"><Run Text="Fecha del aviso " /><Run Text="*" Style="{StaticResource Required}" /></TextBlock>
                                <TextBox Style="{StaticResource Theme.Input}" Tag="dd/mm/aaaa"
                                         Text="{Binding NoticeDateText, UpdateSourceTrigger=PropertyChanged}"
                                         views:FieldError.Text="{Binding NoticeDateError}" />
                                <TextBlock Text="{Binding NoticeDateError}" Style="{StaticResource Theme.ErrorText}" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Width="220" Margin="16,0,0,0">
                                <TextBlock Style="{StaticResource Theme.Label}"><Run Text="Fecha de desocupación " /><Run Text="*" Style="{StaticResource Required}" /></TextBlock>
                                <TextBox Style="{StaticResource Theme.Input}" Tag="dd/mm/aaaa"
                                         Text="{Binding MoveOutDateText, UpdateSourceTrigger=PropertyChanged}"
                                         views:FieldError.Text="{Binding MoveOutDateError}" />
                                <TextBlock Text="{Binding MoveOutDateError}" Style="{StaticResource Theme.ErrorText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Theme.Hint}" Margin="0,12,0,0"
                                   Text="La fecha del aviso no puede ser anterior al inicio del contrato ni posterior a hoy. La de desocupación no puede ser anterior a la del aviso. Al registrarlo, el contrato pasa a En rescisión." />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Continuar" Style="{StaticResource LargePrimary}" Command="{Binding ReviewNoticeCommand}" />
                    <Button Content="Cancelar" Style="{StaticResource LargeGhost}" Margin="12,0,0,0" Command="{Binding CloseActionCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Registrar aviso, step 2: the summary to confirm; nothing is written before "Registrar aviso". -->
            <StackPanel Style="{StaticResource NoticeSummary}">
                <Border Style="{StaticResource Theme.Card}" Width="900" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Revise antes de registrar" Style="{StaticResource Theme.CardTitle}" />
                        <ItemsControl ItemsSource="{Binding ActionCardLines}" ItemTemplate="{StaticResource Line}" />
                        <DockPanel Margin="0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PendingChange.NoticeDate, StringFormat=dd/MM/yyyy}" FontWeight="Bold" />
                            <TextBlock Text="Fecha del aviso" Foreground="{DynamicResource Theme.Muted}" />
                        </DockPanel>
                        <DockPanel Margin="0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PendingChange.MoveOutDate, StringFormat=dd/MM/yyyy}" FontWeight="Bold" />
                            <TextBlock Text="Fecha de desocupación" Foreground="{DynamicResource Theme.Muted}" />
                        </DockPanel>
                        <Separator Margin="0,8" Background="{DynamicResource Theme.Line}" />
                        <TextBlock Text="{Binding PendingChange.Summary}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Theme.Hint}" Margin="0,12,0,0"
                                   Text="El aviso no termina el contrato: sigue vigente y generando períodos hasta que usted lo termine. Si se equivocó, el aviso se puede deshacer." />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Registrar aviso" Style="{StaticResource LargePrimary}" Command="{Binding ConfirmCommand}" />
                    <Button Content="Volver y corregir" Style="{StaticResource LargeGhost}" Margin="12,0,0,0" Command="{Binding CancelCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Deshacer aviso, step 1: why, said under its field when missing. -->
            <StackPanel Style="{StaticResource UndoNoticeForm}">
                <Border Style="{StaticResource Theme.Card}" Width="900" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Motivo" Style="{StaticResource Theme.CardTitle}" />
                        <TextBlock Style="{StaticResource Theme.Label}"><Run Text="Por qué se deshace " /><Run Text="*" Style="{StaticResource Required}" /></TextBlock>
                        <TextBox Style="{StaticResource TextArea}" Tag="Por ejemplo: el inquilino decidió quedarse"
                                 Text="{Binding ChangeReason, UpdateSourceTrigger=PropertyChanged}"
                                 views:FieldError.Text="{Binding ChangeReasonError}" />
                        <TextBlock Text="{Binding ChangeReasonError}" Style="{StaticResource Theme.ErrorText}" Margin="0,6,0,0" />
                        <TextBlock Text="El motivo queda guardado con su nombre y la fecha." Style="{StaticResource Theme.Hint}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Continuar" Style="{StaticResource LargePrimary}" Command="{Binding ReviewUndoNoticeCommand}" />
                    <Button Content="Volver" Style="{StaticResource LargeGhost}" Margin="12,0,0,0" Command="{Binding CloseActionCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Deshacer aviso, step 2: the summary to confirm; nothing is written before "Deshacer". -->
            <StackPanel Style="{StaticResource UndoNoticeSummary}">
                <Border Style="{StaticResource Theme.Card}" Width="900" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Revise antes de deshacer" Style="{StaticResource Theme.CardTitle}" />
                        <TextBlock Text="{Binding PendingChange.Summary}" TextWrapping="Wrap" />
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PendingChange.Reason}" FontWeight="Bold" TextWrapping="Wrap"
                                       MaxWidth="600" TextAlignment="Right" />
                            <TextBlock Text="Motivo" Foreground="{DynamicResource Theme.Muted}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Deshacer" Style="{StaticResource LargePrimary}" Command="{Binding ConfirmCommand}" />
                    <Button Content="Volver y corregir" Style="{StaticResource LargeGhost}" Margin="12,0,0,0" Command="{Binding CancelCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Terminar, step 1: the reason and the date, each with its error under it. -->
            <StackPanel Style="{StaticResource EndForm}">
                <Border Style="{StaticResource Theme.Card}" Width="900" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Motivo y fecha" Style="{StaticResource Theme.CardTitle}" />
                        <TextBlock Style="{StaticResource Theme.Label}"><Run Text="Motivo del fin " /><Run Text="*" Style="{StaticResource Required}" /></TextBlock>
                        <Border Style="{StaticResource Theme.SegmentGroup}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Vencimiento del contrato" GroupName="EndReason" Style="{StaticResource Theme.Segment}"
                                             IsChecked="{Binding EndReason, Converter={StaticResource Equals}, ConverterParameter={x:Static leasing:EndReason.Expiry}}" />
                                <RadioButton Content="Rescisión anticipada del inquilino" GroupName="EndReason" Style="{StaticResource Theme.Segment}"
                                             IsChecked="{Binding EndReason, Converter={StaticResource Equals}, ConverterParameter={x:Static leasing:EndReason.EarlyTerminationByTenant}}" />
                                <RadioButton Content="Rescisión por incumplimiento" GroupName="EndReason" Style="{StaticResource Theme.Segment}"
                                             IsChecked="{Binding EndReason, Converter={StaticResource Equals}, ConverterParameter={x:Static leasing:EndReason.TerminationForCause}}" />
                                <RadioButton Content="Acuerdo de partes" GroupName="EndReason" Style="{StaticResource Theme.Segment}"
                                             IsChecked="{Binding EndReason, Converter={StaticResource Equals}, ConverterParameter={x:Static leasing:EndReason.MutualAgreement}}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding EndReasonError}" Style="{StaticResource Theme.ErrorText}" Margin="0,6,0,0" />
                        <StackPanel Width="220" HorizontalAlignment="Left" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource Theme.Label}"><Run Text="Fecha de fin " /><Run Text="*" Style="{StaticResource Required}" /></TextBlock>
                            <TextBox Style="{StaticResource Theme.Input}" Tag="dd/mm/aaaa"
                                     Text="{Binding EndDateText, UpdateSourceTrigger=PropertyChanged}"
                                     views:FieldError.Text="{Binding EndDateError}" />
                            <TextBlock Text="{Binding EndDateError}" Style="{StaticResource Theme.ErrorText}" Margin="0,6,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Theme.Hint}" Margin="0,12,0,0"
                                   Text="La fecha de fin no puede ser posterior a hoy ni anterior al inicio del contrato. La deuda no impide terminarlo." />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Continuar" Style="{StaticResource LargePrimary}" Command="{Binding ReviewEndCommand}" />
                    <Button Content="Cancelar" Style="{StaticResource LargeGhost}" Margin="12,0,0,0" Command="{Binding CloseActionCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Terminar, step 2: the summary with what is owed; nothing is written before "Terminar contrato". -->
            <StackPanel Style="{StaticResource EndSummary}">
                <Border Style="{StaticResource Theme.Card}" Width="900" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Revise antes de terminar" Style="{StaticResource Theme.CardTitle}" />
                        <DockPanel Margin="0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PendingChange.ReasonText}" FontWeight="Bold" />
                            <TextBlock Text="Motivo" Foreground="{DynamicResource Theme.Muted}" />
                        </DockPanel>
                        <DockPanel Margin="0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PendingChange.EndDate, StringFormat=dd/MM/yyyy}" FontWeight="Bold" />
                            <TextBlock Text="Fecha de fin" Foreground="{DynamicResource Theme.Muted}" />
                        </DockPanel>
                        <Separator Margin="0,8" Background="{DynamicResource Theme.Line}" />
                        <TextBlock Text="{Binding PendingChange.OwedLine}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border CornerRadius="14" Padding="14,10" Margin="0,12,0,0" BorderThickness="1" Width="900" HorizontalAlignment="Left"
                        Background="{DynamicResource Theme.WarnBack}" BorderBrush="{DynamicResource Theme.Warn}"
                        Visibility="{Binding PendingChange.AlreadyWrittenLine, Converter={StaticResource Set}}">
                    <DockPanel>
                        <Viewbox Width="18" Height="18" Margin="0,2,12,0" VerticalAlignment="Top" DockPanel.Dock="Left">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12,3 L22,21 H2 Z M12,10 V15 M12,18 V18.5" Stroke="{DynamicResource Theme.Warn}" StrokeThickness="1.9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{Binding PendingChange.AlreadyWrittenLine}" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Warn}" />
                    </DockPanel>
                </Border>
                <Border CornerRadius="14" Padding="14,10" Margin="0,12,0,0" BorderThickness="1" Width="900" HorizontalAlignment="Left"
                        Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Line}"
                        Visibility="{Binding PendingChange.UnchargedMonthLine, Converter={StaticResource Set}}">
                    <DockPanel>
                        <Viewbox Width="18" Height="18" Margin="0,2,12,0" VerticalAlignment="Top" DockPanel.Dock="Left">
                            <Canvas Width="24" Height="24">
                                <Path Data="M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M12,11 V16 M12,7.5 V8" Stroke="{DynamicResource Theme.Ink2}" StrokeThickness="1.9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{Binding PendingChange.UnchargedMonthLine}" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Ink2}" />
                    </DockPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Terminar contrato" Style="{StaticResource LargePrimary}" Command="{Binding ConfirmCommand}" />
                    <Button Content="Volver y corregir" Style="{StaticResource LargeGhost}" Margin="12,0,0,0" Command="{Binding CancelCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Last step of every action: what it did, with the way back. -->
            <Border CornerRadius="14" Padding="20,16" Margin="0,12,0,0" BorderThickness="1" Width="900" HorizontalAlignment="Left"
                    Background="{DynamicResource Theme.OkBack}" BorderBrush="{DynamicResource Theme.Ok}"
                    Visibility="{Binding Done, Converter={StaticResource Set}}">
                <DockPanel>
                    <Viewbox Width="26" Height="26" Margin="0,0,14,0" VerticalAlignment="Center" DockPanel.Dock="Left">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M8,12.5 L11,15.5 L16,9.5" Stroke="{DynamicResource Theme.Ok}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <Button Content="Volver al contrato" Style="{StaticResource Theme.PrimaryButton}" DockPanel.Dock="Right"
                            VerticalAlignment="Center" Margin="14,0,0,0" Command="{Binding CloseActionCommand}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Done.Title}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Theme.Ink}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding Done.Text}" Foreground="{DynamicResource Theme.Ok}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
