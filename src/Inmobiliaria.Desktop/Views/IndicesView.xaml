<UserControl x:Class="Inmobiliaria.Desktop.Views.IndicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Inmobiliaria.Desktop.Views"
             mc:Ignorable="d"
             d:DesignHeight="1100" d:DesignWidth="1100"
             Style="{StaticResource Theme.Page}">
    <!--
        The Índices screen as the designer drew it (canvas "Índices"): the indices on the left; on the right the selected one,
        the panel that asks its source, the notices and confirmations, the form and the stored values. Bound to
        IndicesViewModel; no logic lives here.
    -->
    <UserControl.Resources>
        <views:SetToVisibleConverter x:Key="Set" />
        <BooleanToVisibilityConverter x:Key="Shown" />

        <!-- A notice: a coloured band with its text. Tag picks the colour, "ok" or "warn". -->
        <Style x:Key="Notice" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Theme.WarnBack}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Warn}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Warn}" />
            <Setter Property="TextElement.FontSize" Value="14" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="ok">
                    <Setter Property="Background" Value="{DynamicResource Theme.OkBack}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Ok}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Ok}" />
                </Trigger>
                <Trigger Property="Tag" Value="info">
                    <Setter Property="Background" Value="{DynamicResource Theme.Background}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Line}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Ink2}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A card asking for a decision: outlined in the accent colour, as on the canvas. -->
        <Style x:Key="AskCard" TargetType="Border" BasedOn="{StaticResource Theme.Card}">
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Button}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- The canvas's .tag: a small capitalised pill, as "Valor encontrado". -->
        <Style x:Key="FoundTag" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Background" Value="{DynamicResource Theme.Surface2}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Ink2}" />
            <Setter Property="TextElement.FontSize" Value="12" />
            <Setter Property="TextElement.FontWeight" Value="Bold" />
        </Style>

        <!-- The canvas's .line: the dashed rule under each row of a list inside a card. -->
        <Style x:Key="DashedRule" TargetType="Line">
            <Setter Property="X2" Value="1" />
            <Setter Property="Stretch" Value="Fill" />
            <Setter Property="Stroke" Value="{DynamicResource Theme.Line}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeDashArray" Value="4 3" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- An index of the list on the left: name and source; the chosen one in the selection colour, outlined. -->
        <Style x:Key="IndexItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Item" CornerRadius="16" Padding="14,12" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Item" Property="Background" Value="{DynamicResource Theme.Select}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Item" Property="Background" Value="{DynamicResource Theme.Select}" />
                                <Setter TargetName="Item" Property="BorderBrush" Value="{DynamicResource Theme.ButtonLine}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- The canvas's 1536 x 785 fit: the page never scrolls; the table scrolls inside, and the middle column only
         when a correction and the form together do not fit. -->
    <Grid Margin="32,20,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
            <TextBlock Text="Índices" Style="{StaticResource Theme.Title}" />
            <TextBlock Grid.Row="1" Text="Los valores publicados que usan los contratos para ajustar el alquiler." Style="{StaticResource Theme.Subtitle}" />
            <TextBlock Grid.Row="2" Text="{Binding Runner.ErrorMessage}" Style="{StaticResource Theme.ErrorText}" Margin="0,12,0,0" />

            <!-- The canvas's .ixgrid: the indices 240 wide, then the middle (1.05) and the table (0.95), 16 apart. -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <!-- The indices. -->
                <Border Grid.Column="0" Style="{StaticResource Theme.Card}" Padding="14" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Índices" Style="{StaticResource Theme.CardTitle}" Margin="6,2,0,8" />
                        <ListBox ItemsSource="{Binding Indices}" SelectedItem="{Binding SelectedIndex}"
                                 ItemContainerStyle="{StaticResource IndexItem}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="{Binding SourceText}" FontSize="13" Foreground="{DynamicResource Theme.Muted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" VerticalAlignment="Top">
                <StackPanel>

                    <!-- The selected index and the way to its source. -->
                    <Border Style="{StaticResource Theme.Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button Content="Traer valores" Style="{StaticResource Theme.GhostButton}" DockPanel.Dock="Right"
                                        VerticalAlignment="Top" Margin="12,0,0,0" Command="{Binding OpenBringCommand}"
                                        Visibility="{Binding CanBringFromSource, Converter={StaticResource Shown}}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedIndex.Name}" FontSize="22" FontWeight="Bold" />
                                    <TextBlock Text="{Binding GuidanceText}" Style="{StaticResource Theme.Hint}" FontSize="14" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Theme.Hint}" Margin="0,12,0,0"
                                       Visibility="{Binding CanBringFromSource, Converter={StaticResource Set}, ConverterParameter=invert}">
                                <Run Text="{Binding SelectedIndex.Name, Mode=OneWay}" /><Run Text=" se escribe a mano: no hay una fuente oficial desde la que traerlo." />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- The panel that asks the source (spec Requirement 25). Nothing is stored until confirmed. -->
                    <Border Style="{StaticResource Theme.Card}" Margin="0,12,0,0"
                            Visibility="{Binding IsBringOpen, Converter={StaticResource Shown}}">
                        <StackPanel>
                            <DockPanel>
                                <Button Content="Cerrar" Style="{StaticResource Theme.SmallGhostButton}" DockPanel.Dock="Right"
                                        Command="{Binding CloseBringCommand}" />
                                <TextBlock Style="{StaticResource Theme.CardTitle}" VerticalAlignment="Center">
                                    <Run Text="Traer valores de " /><Run Text="{Binding SelectedIndex.Name, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding SourceName, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                            </DockPanel>
                            <DockPanel Margin="0,12,0,0">
                                <Button Content="Traer" Style="{StaticResource Theme.PrimaryButton}" DockPanel.Dock="Right"
                                        VerticalAlignment="Top" Margin="16,25,0,0" Command="{Binding BringFromSourceCommand}" />
                                <StackPanel>
                                    <TextBlock Text="Mes a traer (opcional)" Style="{StaticResource Theme.Label}" />
                                    <TextBox Style="{StaticResource Theme.Input}" Tag="Por ejemplo: 10/2026"
                                             Text="{Binding BringPeriodText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Vacío: trae los meses que esperan los ajustes pendientes."
                                               Style="{StaticResource Theme.Hint}" Margin="0,6,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <!-- What the source said, one month at a time. -->
                            <ItemsControl ItemsSource="{Binding Fetched}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="14" Padding="20,16" Margin="0,12,0,0" BorderThickness="1"
                                                BorderBrush="{DynamicResource Theme.Line}" Background="{DynamicResource Theme.Background}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Guardar este valor" Style="{StaticResource Theme.PrimaryButton}" Margin="16,0,0,0"
                                                            Command="{Binding DataContext.ConfirmFetchedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanStore, Converter={StaticResource Shown}}" />
                                                    <Button Content="Corregir ese valor" Style="{StaticResource Theme.SmallGhostButton}" Margin="16,0,0,0"
                                                            Command="{Binding DataContext.CorrectFromFetchedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanCorrect, Converter={StaticResource Shown}}" />
                                                </StackPanel>
                                                <!-- As the canvas: the "Valor encontrado" tag, the level, then the index, month and source. -->
                                                <StackPanel>
                                                    <Border Style="{StaticResource FoundTag}" HorizontalAlignment="Left" Margin="0,0,0,4"
                                                            Visibility="{Binding CanStore, Converter={StaticResource Shown}}">
                                                        <TextBlock Text="VALOR ENCONTRADO" />
                                                    </Border>
                                                    <TextBlock Text="{Binding LevelText}" FontSize="24" FontWeight="Bold"
                                                               Visibility="{Binding LevelText, Converter={StaticResource Set}}" />
                                                    <TextBlock FontSize="14" Foreground="{DynamicResource Theme.Muted}">
                                                        <Run Text="{Binding IndexName, Mode=OneWay}" /><Run Text=" de " /><Run Text="{Binding PeriodText, Mode=OneWay}" /><Run Text=" · fuente: " /><Run Text="{Binding DataContext.SourceName, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" Margin="0,4,0,0"
                                                               Visibility="{Binding Message, Converter={StaticResource Set}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Todavía no se guardó nada. Al guardar valen las mismas revisiones que al escribirlo a mano."
                                       Style="{StaticResource Theme.Hint}" Margin="0,12,0,0"
                                       Visibility="{Binding HasStorableFetched, Converter={StaticResource Shown}}" />
                        </StackPanel>
                    </Border>

                    <!-- A refusal, with the way to correct the value it names; or what was saved. -->
                    <Border Style="{StaticResource Notice}" Margin="0,12,0,0"
                            Visibility="{Binding RefusalMessage, Converter={StaticResource Set}}">
                        <DockPanel>
                            <Button Content="Corregir ese valor" Style="{StaticResource Theme.SmallGhostButton}" DockPanel.Dock="Right"
                                    Margin="12,0,0,0" Command="{Binding CorrectExistingCommand}"
                                    Visibility="{Binding DuplicateOffer, Converter={StaticResource Set}}" />
                            <TextBlock Text="{Binding RefusalMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Notice}" Tag="ok" Margin="0,12,0,0"
                            Visibility="{Binding SavedMessage, Converter={StaticResource Set}}">
                        <TextBlock Text="{Binding SavedMessage}" TextWrapping="Wrap" />
                    </Border>

                    <!-- A level far from the earlier one, to confirm again. -->
                    <Border Style="{StaticResource AskCard}" Margin="0,12,0,0"
                            Visibility="{Binding FarLevelWarning, Converter={StaticResource Set}}">
                        <StackPanel>
                            <Border Style="{StaticResource Notice}">
                                <TextBlock Text="{Binding FarLevelWarning}" TextWrapping="Wrap" />
                            </Border>
                            <!-- The canvas's two .kv side by side: the label on the left, the level on the right. -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DockPanel Margin="0,6">
                                    <TextBlock Text="{Binding FarPreviousLevel}" FontWeight="Bold" DockPanel.Dock="Right" Margin="12,0,0,0" />
                                    <TextBlock Text="{Binding FarPreviousLabel}" Foreground="{DynamicResource Theme.Muted}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <DockPanel Grid.Column="2" Margin="0,6">
                                    <TextBlock Text="{Binding FarTypedLevel}" FontWeight="Bold" DockPanel.Dock="Right" Margin="12,0,0,0" />
                                    <TextBlock Text="{Binding FarTypedLabel}" Foreground="{DynamicResource Theme.Muted}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="Revisar" Style="{StaticResource Theme.GhostButton}" Command="{Binding BackToEditingCommand}" />
                                <Button Content="Confirmar de nuevo" Style="{StaticResource Theme.PrimaryButton}" Margin="12,0,0,0"
                                        Command="{Binding AcceptFarLevelCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- A correction to confirm: both levels, the adjustments that used the value, and its record. -->
                    <Border Style="{StaticResource AskCard}" Margin="0,12,0,0"
                            Visibility="{Binding CorrectionSummary, Converter={StaticResource Set}}">
                        <StackPanel>
                            <TextBlock Text="{Binding CorrectionTitle}" Style="{StaticResource Theme.CardTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DockPanel Margin="0,6">
                                    <TextBlock Text="{Binding CorrectionOldText}" FontWeight="Bold" DockPanel.Dock="Right" Margin="12,0,0,0" />
                                    <TextBlock Text="Valor actual" Foreground="{DynamicResource Theme.Muted}" />
                                </DockPanel>
                                <DockPanel Grid.Column="2" Margin="0,6">
                                    <TextBlock Text="{Binding CorrectionNewText}" FontWeight="Bold" DockPanel.Dock="Right" Margin="12,0,0,0" />
                                    <TextBlock Text="Valor nuevo" Foreground="{DynamicResource Theme.Muted}" />
                                </DockPanel>
                            </Grid>
                            <Border Style="{StaticResource Notice}" Tag="info" Margin="0,12,0,0">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Corregir el valor no cambia ningún ajuste ni ningún alquiler por sí solo. Abajo están los ajustes confirmados que usaron el valor actual." />
                            </Border>

                            <!-- Each list as the canvas's .line rows: what it is on the left, the level on the right, a dashed rule under. -->
                            <TextBlock Text="Ajustes confirmados que usaron este valor" Style="{StaticResource Theme.Label}" Margin="0,12,0,6" />
                            <TextBlock Text="Ningún ajuste confirmado usó este valor." Style="{StaticResource Theme.Hint}"
                                       Visibility="{Binding AffectedAdjustments.Count, Converter={StaticResource Set}, ConverterParameter=invert}" />
                            <ItemsControl ItemsSource="{Binding AffectedAdjustments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <DockPanel Margin="0,7">
                                                <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0">
                                                    <Run Text="usó " Foreground="{DynamicResource Theme.Muted}" /><Run Text="{Binding UsedLevelText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding TenantText, Mode=OneWay}" FontWeight="Bold" /><Run Text=" · desde el " /><Run Text="{Binding EffectiveDateText, Mode=OneWay}" />
                                                </TextBlock>
                                            </DockPanel>
                                            <Line Style="{StaticResource DashedRule}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Correcciones anteriores de este valor" Style="{StaticResource Theme.Label}" Margin="0,12,0,6" />
                            <TextBlock Text="Este valor nunca se corrigió." Style="{StaticResource Theme.Hint}"
                                       Visibility="{Binding Corrections.Count, Converter={StaticResource Set}, ConverterParameter=invert}" />
                            <ItemsControl ItemsSource="{Binding Corrections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <DockPanel Margin="0,7">
                                                <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0">
                                                    <Run Text="{Binding PreviousLevelText, Mode=OneWay}" /><Run Text=" → " /><Run Text="{Binding NewLevelText, Mode=OneWay}" FontWeight="Bold" />
                                                </TextBlock>
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding RecordedAtText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding RecordedBy, Mode=OneWay}" />
                                                </TextBlock>
                                            </DockPanel>
                                            <Line Style="{StaticResource DashedRule}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="Volver a editar" Style="{StaticResource Theme.GhostButton}" Command="{Binding BackToEditingCommand}" Height="42" Padding="26,0" FontSize="15" />
                                <Button Content="Confirmar corrección" Style="{StaticResource Theme.PrimaryButton}" Margin="12,0,0,0"
                                        Height="42" Padding="26,0" FontSize="15" Command="{Binding ConfirmCorrectionCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- A correction saved, with the adjustments it may leave to correct. -->
                    <Border Style="{StaticResource Theme.Card}" Margin="0,12,0,0"
                            Visibility="{Binding CorrectionDone, Converter={StaticResource Set}}">
                        <StackPanel>
                            <Border Style="{StaticResource Notice}" Tag="ok">
                                <TextBlock Text="{Binding CorrectionDone}" TextWrapping="Wrap" />
                            </Border>
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding DoneAdjustments.Count, Converter={StaticResource Set}}">
                                <TextBlock Text="Ningún alquiler cambió. Si corresponde, corrija el último ajuste de cada contrato desde Ajustes de alquiler:"
                                           Style="{StaticResource Theme.Label}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding DoneAdjustments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Margin="0,7" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding TenantText, Mode=OneWay}" FontWeight="Bold" /><Run Text=" · desde el " /><Run Text="{Binding EffectiveDateText, Mode=OneWay}" />
                                                </TextBlock>
                                                <Line Style="{StaticResource DashedRule}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Button Content="Listo" Style="{StaticResource Theme.GhostButton}" HorizontalAlignment="Right" Margin="0,12,0,0"
                                    Command="{Binding DismissDoneCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- The form: a new value, or a correction of the one chosen below. -->
                    <Border Style="{StaticResource Theme.Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding FormTitle}" Style="{StaticResource Theme.CardTitle}" />
                            <!-- The canvas's ".row" as it wraps at 1536: the card is 447 wide, too narrow for the period (220)
                                 and the level (220) side by side, so the period goes alone, the level fills the next line,
                                 and the buttons go under it. -->
                            <StackPanel Width="220" HorizontalAlignment="Left">
                                <TextBlock Text="Período (mes y año)" Style="{StaticResource Theme.Label}" />
                                <Grid>
                                    <TextBox Style="{StaticResource Theme.Input}" Padding="44,0,16,0" Tag="Por ejemplo: 08/2026"
                                             IsEnabled="{Binding CanChoosePeriod}"
                                             Text="{Binding PeriodText, UpdateSourceTrigger=PropertyChanged}" />
                                    <!-- The canvas's calendar icon, inside the field on the left. -->
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0"
                                             IsHitTestVisible="False">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M5,5 H19 A2,2 0 0 1 21,7 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V7 A2,2 0 0 1 5,5 Z M3,10 H21 M8,3 V7 M16,3 V7"
                                                  Stroke="{DynamicResource Theme.Muted}" StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <TextBlock Text="{Binding PeriodError}" Style="{StaticResource Theme.ErrorText}" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,16,0,0">
                                <TextBlock Text="Nivel publicado" Style="{StaticResource Theme.Label}" />
                                <Grid>
                                    <TextBox Style="{StaticResource Theme.Input}" Padding="34,0,16,0" Tag="{Binding LevelExample}"
                                             Text="{Binding LevelText, UpdateSourceTrigger=PropertyChanged}" />
                                    <!-- "$" for an index in pesos, "#" for an index number, as on the canvas. -->
                                    <TextBlock Text="{Binding LevelPrefix}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"
                                               FontSize="15" Foreground="{DynamicResource Theme.Muted}" IsHitTestVisible="False" />
                                </Grid>
                                <TextBlock Text="{Binding LevelError}" Style="{StaticResource Theme.ErrorText}" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Cancelar" Style="{StaticResource Theme.GhostButton}" Command="{Binding ClearFormCommand}"
                                        Visibility="{Binding IsEditing, Converter={StaticResource Shown}}" Margin="0,0,10,0" />
                                <Button Content="{Binding SaveText}" Style="{StaticResource Theme.PrimaryButton}"
                                        Command="{Binding SaveCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding FormHint}" Style="{StaticResource Theme.Hint}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                </StackPanel>
                </ScrollViewer>

                <!-- The stored values, the latest first. Values are never deleted: a wrong one is corrected. -->
                <Border Grid.Column="4" Style="{StaticResource Theme.Card}" Padding="8,8,8,4" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Theme.CardTitle}" Margin="14,10,14,12">
                                <Run Text="Valores guardados de " /><Run Text="{Binding SelectedIndex.Name, Mode=OneWay}" />
                            </TextBlock>
                            <DataGrid Grid.Row="1" Style="{StaticResource Theme.Table}" ItemsSource="{Binding Values}"
                                      SelectedItem="{Binding Editing, Mode=OneWay}" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="PERÍODO" Width="1*" MinWidth="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PeriodText}" FontWeight="Bold" TextAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="NIVEL" Binding="{Binding ShownLevelText}" Width="1.4*" MinWidth="100" />
                                    <DataGridTemplateColumn Header="CORRECCIONES" Width="1.2*" MinWidth="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Border Style="{StaticResource Theme.Chip}" HorizontalAlignment="Center"
                                                            Visibility="{Binding IsCorrected, Converter={StaticResource Shown}}">
                                                        <TextBlock Text="{Binding CorrectionsText}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding CorrectionsText}" TextAlignment="Center"
                                                               Foreground="{DynamicResource Theme.Muted}"
                                                               Visibility="{Binding IsCorrected, Converter={StaticResource Set}, ConverterParameter=invert}" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="1*" MinWidth="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Corregir" Style="{StaticResource Theme.SmallGhostButton}" HorizontalAlignment="Center"
                                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2" Style="{StaticResource Theme.Hint}" Margin="14,22,14,14">
                                <Run Text="{Binding CountText, Mode=OneWay}" /><Run Text=". Los valores no se borran: uno mal cargado se corrige, y cada corrección queda registrada." />
                            </TextBlock>
                    </Grid>
                </Border>
            </Grid>
    </Grid>
</UserControl>
