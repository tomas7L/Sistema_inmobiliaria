<UserControl x:Class="Inmobiliaria.Desktop.Views.ContractAdjustmentCorrectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:leasing="clr-namespace:Inmobiliaria.Domain.Leasing;assembly=Inmobiliaria.Domain"
             xmlns:views="clr-namespace:Inmobiliaria.Desktop.Views"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d"
             d:DesignHeight="785" d:DesignWidth="1268">
    <!--
        The correction of the contract's latest adjustment as the designer drew it (canvas "Corregir ajuste", 1536 x 785), in place
        of the detail while it is open: the contract it is for, the indices' values used, what the correction does to the earlier
        difference, the difference it offers with its choice, the figures, and the notice once confirmed. Bound to the open
        contract's ContractDetailViewModel; every figure and text is its Adjustments' own. Cards at most 900 wide, as the actions'.
    -->
    <UserControl.Resources>
        <views:SetToVisibleConverter x:Key="Set" />
        <views:EqualsConverter x:Key="Equals" />
        <BooleanToVisibilityConverter x:Key="Shown" />
        <sys:Boolean x:Key="True">True</sys:Boolean>
        <sys:Boolean x:Key="False">False</sys:Boolean>

        <!-- One figure: what it is, muted, and its value, bold. -->
        <Style x:Key="Figure" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,6" />
        </Style>

        <Style x:Key="LargeGhost" TargetType="Button" BasedOn="{StaticResource Theme.GhostButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="26,0" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="LargePrimary" TargetType="Button" BasedOn="{StaticResource Theme.PrimaryButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="26,0" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Corregir ajuste" Style="{StaticResource Theme.Title}" />
            <TextBlock Text="Se corrige el último ajuste del contrato. Si el valor de un índice estaba mal, corríjalo primero en Índices."
                       Style="{StaticResource Theme.Subtitle}" />
            <!-- The back link of every screen: a small ghost button with its chevron, under the title on the left. -->
            <Button Style="{StaticResource Theme.SmallGhostButton}" Padding="10,0,14,0" HorizontalAlignment="Left"
                    Margin="0,12,0,0" Command="{Binding Adjustments.CloseCorrectionCommand}">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                        <Canvas Width="24" Height="24">
                            <Path Data="M15,6 L9,12 L15,18" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Volver al contrato" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Text="{Binding Runner.ErrorMessage}" Style="{StaticResource Theme.ErrorText}" Margin="0,12,0,0" />
            <TextBlock Text="{Binding Adjustments.RefusalMessage}" Style="{StaticResource Theme.ErrorText}" Margin="0,12,0,0" Width="900"
                       HorizontalAlignment="Left" TextWrapping="Wrap" />

            <!-- The contract it is for, with its state. -->
            <Border Style="{StaticResource Theme.Card}" Width="900" HorizontalAlignment="Left" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Margin="0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Theme.Chip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Detail.Status}" Value="{x:Static leasing:ContractStatus.Active}">
                                            <Setter Property="Tag" Value="ok" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Detail.Status}" Value="{x:Static leasing:ContractStatus.PendingTermination}">
                                            <Setter Property="Tag" Value="warn" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusText}" />
                        </Border>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Theme.CardTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding CorrectionHeaderText}" Foreground="{DynamicResource Theme.Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- The summary to confirm; nothing is written before "Confirmar corrección". -->
            <StackPanel Visibility="{Binding Adjustments.IsSummaryOpen, Converter={StaticResource Shown}}">
                <Border Style="{StaticResource Theme.Card}" Width="900" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Valores de los índices que se usaron" Style="{StaticResource Theme.CardTitle}" />
                        <DataGrid Style="{StaticResource Theme.Table}" ItemsSource="{Binding Adjustments.SummaryLines}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ÍNDICE" Binding="{Binding IndexName}" Width="1*" MinWidth="90" />
                                <DataGridTemplateColumn Header="VALOR BASE" Width="1.2*" MinWidth="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock TextAlignment="Center">
                                                <Run Text="{Binding BaseLevelText, Mode=OneWay}" FontWeight="Bold" /><Run Text="  " /><Run Text="{Binding BasePeriodText, Mode=OneWay}" Foreground="{DynamicResource Theme.Muted}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="VALOR FINAL" Width="1.2*" MinWidth="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock TextAlignment="Center">
                                                <Run Text="{Binding EndLevelText, Mode=OneWay}" FontWeight="Bold" /><Run Text="  " /><Run Text="{Binding EndPeriodText, Mode=OneWay}" Foreground="{DynamicResource Theme.Muted}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="VARIACIÓN" Binding="{Binding VariationText}" Width="1*" MinWidth="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding Adjustments.CorrectionText}" Style="{StaticResource Theme.Hint}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding Adjustments.DifferenceOutcomeText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding Adjustments.DifferenceOutcomeText, Converter={StaticResource Set}}" />
                    </StackPanel>
                </Border>

                <!-- The difference this correction offers, with the operator's choice: no until they say yes. -->
                <Border Style="{StaticResource Theme.Card}" Width="900" HorizontalAlignment="Left" Margin="0,12,0,0"
                        Visibility="{Binding Adjustments.HasDifference, Converter={StaticResource Shown}}">
                    <StackPanel>
                        <TextBlock Text="Diferencia de ajuste" Style="{StaticResource Theme.CardTitle}" />
                        <TextBlock Text="{Binding Adjustments.DifferenceText}" TextWrapping="Wrap" />
                        <Border Style="{StaticResource Theme.SegmentGroup}" HorizontalAlignment="Left" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="No cobrar" GroupName="ChargeDifference" Style="{StaticResource Theme.Segment}"
                                             IsChecked="{Binding Adjustments.ChargeDifference, Converter={StaticResource Equals}, ConverterParameter={StaticResource False}}" />
                                <RadioButton Content="Cobrar la diferencia" GroupName="ChargeDifference" Style="{StaticResource Theme.Segment}"
                                             IsChecked="{Binding Adjustments.ChargeDifference, Converter={StaticResource Equals}, ConverterParameter={StaticResource True}}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Por defecto no se cobra. Si la cobra, se agrega como un cargo aparte al confirmar."
                                   Style="{StaticResource Theme.Hint}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- The figures: the rent before, the coefficient, the exact result and the canon it truncates to. -->
                <Border Style="{StaticResource Theme.Card}" Width="900" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Figure}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Adjustments.PreviousCanonText}" FontWeight="Bold" />
                            <TextBlock Text="Alquiler antes del ajuste" Foreground="{DynamicResource Theme.Muted}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Figure}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Adjustments.CoefficientText}" FontWeight="Bold" />
                            <TextBlock Text="Coeficiente" Foreground="{DynamicResource Theme.Muted}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Figure}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Adjustments.ExactCanonText}" FontWeight="Bold" />
                            <TextBlock Text="Resultado exacto" Foreground="{DynamicResource Theme.Muted}" />
                        </DockPanel>
                        <Separator Margin="0,8" Background="{DynamicResource Theme.Line}" />
                        <DockPanel Style="{StaticResource Figure}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Adjustments.NewCanonText}" FontWeight="Bold" FontSize="18" />
                            <TextBlock Text="Alquiler corregido" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Theme.Hint}" TextWrapping="Wrap" Margin="0,6,0,0">
                            <Run Text="Se trunca al peso entero: no se cobran centavos ni se redondea. Rige desde el período " /><Run Text="{Binding Adjustments.AppliesFromText, Mode=OneWay}" /><Run Text="." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Cancelar" Style="{StaticResource LargeGhost}" Command="{Binding Adjustments.CloseCorrectionCommand}" />
                    <Button Content="Confirmar corrección" Style="{StaticResource LargePrimary}" Margin="12,0,0,0"
                            Command="{Binding Adjustments.ConfirmCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- What the correction did, with the reminder to tell the tenant and the way back. -->
            <Border CornerRadius="14" Padding="20,16" Margin="0,12,0,0" BorderThickness="1" Width="900" HorizontalAlignment="Left"
                    Background="{DynamicResource Theme.OkBack}" BorderBrush="{DynamicResource Theme.Ok}"
                    Visibility="{Binding Adjustments.ConfirmedMessage, Converter={StaticResource Set}}">
                <DockPanel>
                    <Viewbox Width="26" Height="26" Margin="0,0,14,0" VerticalAlignment="Center" DockPanel.Dock="Left">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M8,12.5 L11,15.5 L16,9.5" Stroke="{DynamicResource Theme.Ok}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <Button Content="Volver al contrato" Style="{StaticResource Theme.PrimaryButton}" DockPanel.Dock="Right"
                            VerticalAlignment="Center" Margin="14,0,0,0" Command="{Binding Adjustments.CloseCorrectionCommand}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Adjustments.ConfirmedMessage}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Theme.Ink}"
                                   TextWrapping="Wrap" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding Adjustments.NoticeReminder}" Foreground="{DynamicResource Theme.Ok}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
