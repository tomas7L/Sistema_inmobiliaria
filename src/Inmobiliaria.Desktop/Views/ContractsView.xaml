<UserControl x:Class="Inmobiliaria.Desktop.Views.ContractsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:contracts="clr-namespace:Inmobiliaria.Presentation.Contracts;assembly=Inmobiliaria.Presentation"
             xmlns:leasing="clr-namespace:Inmobiliaria.Domain.Leasing;assembly=Inmobiliaria.Domain"
             xmlns:views="clr-namespace:Inmobiliaria.Desktop.Views"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1100"
             Style="{StaticResource Theme.Page}">
    <!--
        The Contratos screen as the designer drew it (canvas "Contratos" and "Detalle del contrato"): the contracts with their
        state, filtered by state on the screen and searched by tenant, lessor or unit, and in its place the one opened.
        Bound to ContractsViewModel; no logic lives here.
    -->
    <UserControl.Resources>
        <views:EqualsConverter x:Key="Equals" />
        <views:SetToVisibleConverter x:Key="SetShown" />
        <BooleanToVisibilityConverter x:Key="Shown" />

        <!-- Shown only while neither a contract nor the form is open. -->
        <Style x:Key="ListPart" TargetType="Grid">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsListShown}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- The canvas's 1536 x 785 fit: the page never scrolls, the tables scroll inside their card. -->
    <Grid Margin="32,20,32,16">

        <!-- The list. -->
        <Grid Style="{StaticResource ListPart}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Contratos" Style="{StaticResource Theme.Title}" />
            <TextBlock Grid.Row="1" Text="Alquileres cargados, con su estado. Abra uno para ver todos sus datos." Style="{StaticResource Theme.Subtitle}" />
            <TextBlock Grid.Row="2" Text="{Binding Runner.ErrorMessage}" Style="{StaticResource Theme.ErrorText}" Margin="0,12,0,0" />

            <!-- A contract just saved, said here, where the form returns (Tomás, 2026-11-17): the green band of the other
                 screens' saved notice, the canvas's .alert-ok. -->
            <Border Grid.Row="3" CornerRadius="14" Padding="20,16" Margin="0,12,0,0" BorderThickness="1"
                    Background="{DynamicResource Theme.OkBack}" BorderBrush="{DynamicResource Theme.Ok}"
                    Visibility="{Binding SavedMessage, Converter={StaticResource SetShown}}">
                <DockPanel>
                    <Viewbox Width="26" Height="26" Margin="0,0,14,0" VerticalAlignment="Center" DockPanel.Dock="Left">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M8,12.5 L11,15.5 L16,9.5" Stroke="{DynamicResource Theme.Ok}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SavedMessage}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Theme.Ink}"
                                   TextWrapping="Wrap" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding SavedDetail}" Foreground="{DynamicResource Theme.Ok}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource Theme.Card}" CornerRadius="22" Padding="16,12" Margin="0,12,0,0">
                <!-- The search box takes what the filters leave, to the card's right edge, as on the canvas. -->
                <DockPanel LastChildFill="True">
                    <Button Content="Nuevo contrato" Style="{StaticResource Theme.PrimaryButton}" DockPanel.Dock="Left"
                            Command="{Binding NewCommand}" Margin="0,4,12,4" />
                    <Border Style="{StaticResource Theme.SegmentGroup}" Margin="0,4,0,4" DockPanel.Dock="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Todos" GroupName="StateFilter" Style="{StaticResource Theme.Segment}"
                                         IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter={x:Static contracts:ContractListFilter.All}}" />
                            <RadioButton Content="Vigentes" GroupName="StateFilter" Style="{StaticResource Theme.Segment}"
                                         IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter={x:Static contracts:ContractListFilter.Active}}" />
                            <RadioButton Content="En rescisión" GroupName="StateFilter" Style="{StaticResource Theme.Segment}"
                                         IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter={x:Static contracts:ContractListFilter.PendingTermination}}" />
                            <RadioButton Content="Finalizados" GroupName="StateFilter" Style="{StaticResource Theme.Segment}"
                                         IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter={x:Static contracts:ContractListFilter.Ended}}" />
                            <RadioButton Content="Cancelados" GroupName="StateFilter" Style="{StaticResource Theme.Segment}"
                                         IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter={x:Static contracts:ContractListFilter.Cancelled}}" />
                        </StackPanel>
                    </Border>
                    <TextBox Style="{StaticResource Theme.Input}" Margin="12,4,0,4" MinWidth="220"
                             Tag="Inquilino, propietario o propiedad (Enter para buscar)"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding LoadCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
            </Border>

            <Border Grid.Row="5" Style="{StaticResource Theme.Card}" Padding="8,8,8,4" Margin="0,12,0,0"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- The canvas's "compact" table: Theme.TableCell's 10,14 is already its padding. -->
                    <DataGrid Style="{StaticResource Theme.Table}" ItemsSource="{Binding Contracts}" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="INQUILINO" Width="1.4*" MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Tenants}" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="PROPIETARIO" Width="1.4*" MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Lessors}" TextAlignment="Center" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="PROPIEDAD" Width="1.6*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Units}" TextAlignment="Center" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--
                                The state, and beside it, as on the canvas, the past-end mark, which never ends the contract (spec
                                Requirement 6). It wraps under the state when the column is too narrow for both.
                            -->
                            <DataGridTemplateColumn Header="ESTADO" Width="1.8*" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <WrapPanel HorizontalAlignment="Center">
                                            <Border x:Name="Chip" Style="{StaticResource Theme.Chip}" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" TextAlignment="Center" />
                                            </Border>
                                            <Border x:Name="PastEnd" Style="{StaticResource Theme.Chip}" Tag="warn" HorizontalAlignment="Center"
                                                    Margin="4,0,0,0">
                                                <TextBlock Text="{Binding PastEndFlag}" />
                                            </Border>
                                        </WrapPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Listing.Status}" Value="{x:Static leasing:ContractStatus.Active}">
                                                <Setter TargetName="Chip" Property="Tag" Value="ok" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Listing.Status}" Value="{x:Static leasing:ContractStatus.PendingTermination}">
                                                <Setter TargetName="Chip" Property="Tag" Value="warn" />
                                            </DataTrigger>
                                            <!-- Last, so a cancelled one reads red although its state is Ended. -->
                                            <DataTrigger Binding="{Binding Listing.IsCancelled}" Value="True">
                                                <Setter TargetName="Chip" Property="Tag" Value="bad" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PastEndFlag}" Value="{x:Null}">
                                                <Setter TargetName="PastEnd" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="FIN" Binding="{Binding EndText}" Width="0.9*" MinWidth="100" />
                            <DataGridTextColumn Header="ALQUILER" Binding="{Binding RentText}" Width="1*" MinWidth="110" />
                            <DataGridTemplateColumn Header="" Width="0.8*" MinWidth="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Abrir" Style="{StaticResource Theme.SmallGhostButton}" HorizontalAlignment="Center"
                                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="No hay ningún contrato con ese filtro o esa búsqueda." Style="{StaticResource Theme.Hint}"
                               FontSize="15" Margin="14,18"
                               Visibility="{Binding IsEmpty, Converter={StaticResource Shown}}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource Theme.Hint}" Margin="14,10,14,14" TextWrapping="Wrap">
                        <Run Text="{Binding CountText, Mode=OneWay}" /><Run Text=". Un contrato que pasó su fecha de fin sigue vigente hasta que se lo termine: acá solo se marca. Los cancelados siguen visibles, con su motivo en el detalle." />
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- The contract opened, in place of the list: its tables scroll inside their card, as the list's. An action with its
             own screen ("Registrar aviso") takes the detail's place while it is open. -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsDetailOpen}" Value="True" />
                                <Condition Binding="{Binding OpenDetail.IsActionOpen}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding OpenDetail.Title}" Style="{StaticResource Theme.Title}" />
                <TextBlock Text="{Binding OpenDetail.Subtitle}" Style="{StaticResource Theme.Subtitle}" />
                <!-- The canvas's back link: a small ghost button with its chevron, under the title on the left. The contract's
                     actions go on its right as their screens are built. -->
                <!-- The canvas's line under the title: the way back on the left, the contract's actions on the right, each
                     shown where its state offers it. Only the actions whose screens are built are here. -->
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Registrar aviso" Style="{StaticResource Theme.GhostButton}"
                                Command="{Binding OpenDetail.OpenNoticeCommand}"
                                Visibility="{Binding OpenDetail.IsNoticeOffered, Converter={StaticResource Shown}}" />
                        <Button Content="Deshacer aviso" Style="{StaticResource Theme.GhostButton}" Margin="10,0,0,0"
                                Command="{Binding OpenDetail.OpenUndoNoticeCommand}"
                                Visibility="{Binding OpenDetail.IsUndoNoticeOffered, Converter={StaticResource Shown}}" />
                        <Button Content="Terminar" Style="{StaticResource Theme.GhostButton}" Margin="10,0,0,0"
                                Command="{Binding OpenDetail.OpenEndCommand}"
                                Visibility="{Binding OpenDetail.IsEndOffered, Converter={StaticResource Shown}}" />
                        <Button Content="Deshacer fin" Style="{StaticResource Theme.GhostButton}" Margin="10,0,0,0"
                                Command="{Binding OpenDetail.OpenUndoEndCommand}"
                                Visibility="{Binding OpenDetail.IsUndoEndOffered, Converter={StaticResource Shown}}" />
                        <Button Content="Cancelar por error" Style="{StaticResource Theme.GhostButton}" Margin="10,0,0,0"
                                Command="{Binding OpenDetail.OpenCancelCommand}"
                                Visibility="{Binding OpenDetail.IsCancelOffered, Converter={StaticResource Shown}}" />
                    </StackPanel>
                    <Button Style="{StaticResource Theme.SmallGhostButton}" Padding="10,0,14,0" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Command="{Binding BackCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M15,6 L9,12 L15,18" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Volver a contratos" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DockPanel>
            </StackPanel>
            <views:ContractDetailView Grid.Row="1" DataContext="{Binding OpenDetail}" />
        </Grid>

        <!-- The action open ("Registrar aviso", "Deshacer aviso"), in place of the detail. Its DataContext is the open contract,
             so its own bindings, Visibility included, are read from it: IsActionOpen, not OpenDetail.IsActionOpen. -->
        <views:ContractActionView DataContext="{Binding OpenDetail}"
                                  Visibility="{Binding IsActionOpen, Converter={StaticResource Shown}, FallbackValue=Collapsed}" />

        <!-- The form of a new contract, in place of the list. It scrolls only on a screen smaller than the canvas's. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsFormOpen, Converter={StaticResource Shown}}">
            <StackPanel>
                <TextBlock Text="Nuevo contrato" Style="{StaticResource Theme.Title}" />
                <TextBlock Text="Complete las partes, la propiedad, las fechas y los importes. Al guardar se crea también su cuenta, vacía."
                           Style="{StaticResource Theme.Subtitle}" />
                <!-- The back link of every screen: a small ghost button with its chevron, under the title on the left. -->
                <Button Style="{StaticResource Theme.SmallGhostButton}" Padding="10,0,14,0" HorizontalAlignment="Left"
                        Margin="0,12,0,0" Command="{Binding BackCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M15,6 L9,12 L15,18" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Volver a contratos" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <views:ContractFormView DataContext="{Binding OpenForm}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
