<UserControl x:Class="Inmobiliaria.Desktop.Views.ContractDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:contracts="clr-namespace:Inmobiliaria.Presentation.Contracts;assembly=Inmobiliaria.Presentation"
             xmlns:leasing="clr-namespace:Inmobiliaria.Domain.Leasing;assembly=Inmobiliaria.Domain"
             xmlns:views="clr-namespace:Inmobiliaria.Desktop.Views"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1300">
    <!--
        One contract as the designer drew it (canvas "Detalle del contrato"): its state, and three tabs, the Resumen's cards,
        the adjustment history and the event log. Bound to ContractDetailViewModel; no logic lives here. The title and
        "Volver a contratos" are the list's, which hosts this in its place. The canvas's 1536 x 785 fit: the tables scroll
        inside their card, the page does not.
    -->
    <UserControl.Resources>
        <views:EqualsConverter x:Key="Equals" />
        <BooleanToVisibilityConverter x:Key="Shown" />

        <!-- One line of a card, the canvas's "kv": what it is, muted, and its value, bold, on the same row. -->
        <DataTemplate x:Key="DetailLineRow" DataType="{x:Type contracts:DetailLine}">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Theme.Muted}" TextWrapping="Wrap" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Right" MaxWidth="260" />
            </Grid>
        </DataTemplate>

        <!-- The canvas's .tabs: plain words, the chosen one in ink over a 3 px rule in the menu's blue, all on one grey line. -->
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource Theme.Font}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,-1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Rule" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="18,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Ink}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Ink}" />
                                <Setter TargetName="Rule" Property="BorderBrush" Value="{DynamicResource Theme.NavOn}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Rule" Property="Background" Value="{DynamicResource Theme.Select}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The card's 12 gap before each line; the card's title then carries no margin of its own, so the gap is not doubled. -->
        <Style x:Key="DetailLineGap" TargetType="ContentPresenter">
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Runner.ErrorMessage}" Style="{StaticResource Theme.ErrorText}" Margin="0,12,0,0" />

        <!-- The state, and what it means for the operator. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <!-- Coloured as on the list: green in force, amber with notice, neutral ended, red cancelled. -->
            <Border Margin="0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Theme.Chip}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Detail.Status}" Value="{x:Static leasing:ContractStatus.Active}">
                                <Setter Property="Tag" Value="ok" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Detail.Status}" Value="{x:Static leasing:ContractStatus.PendingTermination}">
                                <Setter Property="Tag" Value="warn" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Detail.IsCancelled}" Value="True">
                                <Setter Property="Tag" Value="bad" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusText}" />
            </Border>
            <TextBlock Text="{Binding StateNote}" Style="{StaticResource Theme.Hint}" VerticalAlignment="Center" Margin="10,0,0,0" />
        </StackPanel>

        <!-- The tabs. -->
        <Border Grid.Row="2" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Theme.Line}" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Resumen" GroupName="DetailTab" Style="{StaticResource Tab}"
                             IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter={x:Static contracts:ContractDetailTab.Summary}}" />
                <RadioButton Content="Historial de ajustes" GroupName="DetailTab" Style="{StaticResource Tab}"
                             IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter={x:Static contracts:ContractDetailTab.Adjustments}}" />
                <RadioButton Content="Registro de eventos" GroupName="DetailTab" Style="{StaticResource Tab}"
                             IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter={x:Static contracts:ContractDetailTab.Events}}" />
            </StackPanel>
        </Border>

        <!-- Resumen: the canvas's "dgrid", three columns of cards. It scrolls only on a screen smaller than the canvas's. -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tab}" Value="{x:Static contracts:ContractDetailTab.Summary}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
        <Grid VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The canvas's "dcol": its cards 16 apart. -->
            <StackPanel>
                <Border Style="{StaticResource Theme.Card}">
                    <StackPanel>
                        <TextBlock Text="Partes" Style="{StaticResource Theme.CardTitle}" Margin="0" />
                        <ItemsControl ItemsSource="{Binding PartyLines}" ItemTemplate="{StaticResource DetailLineRow}"
                                      ItemContainerStyle="{StaticResource DetailLineGap}" />
                        <TextBlock Style="{StaticResource Theme.Hint}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Text="El codeudor se puede agregar, cambiar o quitar en cualquier momento. El inquilino y los propietarios, solo hasta el primer movimiento de la cuenta." />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Theme.Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Propiedad" Style="{StaticResource Theme.CardTitle}" Margin="0" />
                        <ItemsControl ItemsSource="{Binding UnitLines}" ItemTemplate="{StaticResource DetailLineRow}"
                                      ItemContainerStyle="{StaticResource DetailLineGap}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Theme.Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Cláusula de ajuste" Style="{StaticResource Theme.CardTitle}" Margin="0" />
                    <ItemsControl ItemsSource="{Binding ClauseLines}" ItemTemplate="{StaticResource DetailLineRow}"
                                  ItemContainerStyle="{StaticResource DetailLineGap}" />
                    <!--
                        Only under the clause's lines: without a clause there is nothing above it to separate. The canvas's "sep":
                        2 above and below it, plus the card's 12 gap.
                    -->
                    <Separator Margin="0,14,0,2" Background="{DynamicResource Theme.Line}">
                        <Separator.Style>
                            <Style TargetType="Separator">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail.Clause}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Separator.Style>
                    </Separator>
                    <TextBlock Text="{Binding NextAdjustmentText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <TextBlock Style="{StaticResource Theme.Hint}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="La cláusula se puede cambiar hasta el primer ajuste confirmado. El cambio vale desde el próximo ajuste." />
                </StackPanel>
            </Border>

            <!-- This card's gap is 4 on the canvas, not the card's 12. -->
            <Border Grid.Column="4" Style="{StaticResource Theme.Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Importes y fechas" Style="{StaticResource Theme.CardTitle}" Margin="0" />
                    <ItemsControl ItemsSource="{Binding AmountLines}" ItemTemplate="{StaticResource DetailLineRow}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,4,0,0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
        </ScrollViewer>

        <!-- Historial de ajustes: the canvas's "tcard", whose table scrolls inside it. -->
        <Border Grid.Row="3" Padding="8,8,8,4" Margin="0,12,0,0" VerticalAlignment="Top">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Theme.Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tab}" Value="{x:Static contracts:ContractDetailTab.Adjustments}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Historial de ajustes" Style="{StaticResource Theme.CardTitle}" Margin="14,10,14,12" />
                <DataGrid Grid.Row="1" Style="{StaticResource Theme.Table}" ItemsSource="{Binding Adjustments.History}"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="VENCE · RIGE DESDE" Width="1.2*" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DueDateText}" TextAlignment="Center" />
                                        <TextBlock FontWeight="Bold" TextAlignment="Center">
                                            <Run Text="Rige desde " /><Run Text="{Binding AppliesFromText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ALQUILER" Width="1.2*" MinWidth="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource Theme.Muted}" TextAlignment="Center">
                                            <Run Text="antes " /><Run Text="{Binding PreviousCanonText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding NewCanonText}" FontWeight="Bold" TextAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="COEFICIENTE" Binding="{Binding CoefficientText}" Width="1*" MinWidth="110" />
                        <DataGridTemplateColumn Header="CONFIRMÓ" Width="1.4*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ConfirmedByText}" TextAlignment="Center" TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="DIFERENCIA" Width="1.4*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DifferenceText}" TextAlignment="Center" TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="2" Text="Este contrato todavía no tiene ajustes confirmados." Style="{StaticResource Theme.Hint}"
                           FontSize="15" Margin="14,18"
                           Visibility="{Binding Adjustments.HasNoAdjustments, Converter={StaticResource Shown}}" />
            </Grid>
        </Border>

        <!-- Registro de eventos: the canvas's "tcard", whose table scrolls inside it. -->
        <Border Grid.Row="3" Padding="8,8,8,4" Margin="0,12,0,0" VerticalAlignment="Top">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Theme.Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tab}" Value="{x:Static contracts:ContractDetailTab.Events}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Registro de eventos" Style="{StaticResource Theme.CardTitle}" Margin="14,10,14,12" />
                <DataGrid Grid.Row="1" Style="{StaticResource Theme.Table}" ItemsSource="{Binding Events}"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CUÁNDO" Binding="{Binding WhenText}" Width="0.8*" MinWidth="110" />
                        <DataGridTemplateColumn Header="EVENTO" Width="1.2*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EventText}" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="MOTIVO" Width="2*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ReasonText}" TextAlignment="Center" TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="QUIÉN" Width="1.2*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding WhoText}" TextAlignment="Center" TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="2" Text="Todavía no hay avisos, fines ni cancelaciones en este contrato." Style="{StaticResource Theme.Hint}"
                           FontSize="15" Margin="14,6,14,14"
                           Visibility="{Binding HasNoEvents, Converter={StaticResource Shown}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
