<UserControl x:Class="Inmobiliaria.Desktop.Views.ContractDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:contracts="clr-namespace:Inmobiliaria.Presentation.Contracts;assembly=Inmobiliaria.Presentation"
             xmlns:leasing="clr-namespace:Inmobiliaria.Domain.Leasing;assembly=Inmobiliaria.Domain"
             xmlns:views="clr-namespace:Inmobiliaria.Desktop.Views"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1300">
    <!--
        One contract as the designer drew it (canvas "Detalle del contrato"): its state, and three tabs, the Resumen's cards,
        the adjustment history and the event log. Bound to ContractDetailViewModel; no logic lives here. The title and
        "Volver a contratos" are the list's, which hosts this in its place.
    -->
    <UserControl.Resources>
        <views:EqualsConverter x:Key="Equals" />
        <BooleanToVisibilityConverter x:Key="Shown" />

        <!-- One line of a card: what it is, muted, and its value, bold, on the same row. -->
        <DataTemplate x:Key="DetailLineRow" DataType="{x:Type contracts:DetailLine}">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Theme.Muted}" TextWrapping="Wrap" Margin="0,0,16,0" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Right" MaxWidth="260" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding Runner.ErrorMessage}" Style="{StaticResource Theme.ErrorText}" Margin="0,12,0,0" />

        <!-- The state, and what it means for the operator. -->
        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <!-- Coloured as on the list: green in force, amber with notice, neutral ended, red cancelled. -->
            <Border Margin="0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Theme.Chip}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Detail.Status}" Value="{x:Static leasing:ContractStatus.Active}">
                                <Setter Property="Tag" Value="ok" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Detail.Status}" Value="{x:Static leasing:ContractStatus.PendingTermination}">
                                <Setter Property="Tag" Value="warn" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Detail.IsCancelled}" Value="True">
                                <Setter Property="Tag" Value="bad" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusText}" />
            </Border>
            <TextBlock Text="{Binding StateNote}" Style="{StaticResource Theme.Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <!-- The tabs. -->
        <Border Style="{StaticResource Theme.SegmentGroup}" HorizontalAlignment="Left" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Resumen" GroupName="DetailTab" Style="{StaticResource Theme.Segment}"
                             IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter={x:Static contracts:ContractDetailTab.Summary}}" />
                <RadioButton Content="Historial de ajustes" GroupName="DetailTab" Style="{StaticResource Theme.Segment}"
                             IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter={x:Static contracts:ContractDetailTab.Adjustments}}" />
                <RadioButton Content="Registro de eventos" GroupName="DetailTab" Style="{StaticResource Theme.Segment}"
                             IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter={x:Static contracts:ContractDetailTab.Events}}" />
            </StackPanel>
        </Border>

        <!-- Resumen: three columns of cards. -->
        <Grid Margin="0,18,0,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tab}" Value="{x:Static contracts:ContractDetailTab.Summary}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{StaticResource Theme.Card}">
                    <StackPanel>
                        <TextBlock Text="Partes" Style="{StaticResource Theme.CardTitle}" />
                        <ItemsControl ItemsSource="{Binding PartyLines}" ItemTemplate="{StaticResource DetailLineRow}" />
                        <TextBlock Style="{StaticResource Theme.Hint}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="El codeudor se puede agregar, cambiar o quitar en cualquier momento. El inquilino y los propietarios, solo hasta el primer movimiento de la cuenta." />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Theme.Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Propiedad" Style="{StaticResource Theme.CardTitle}" />
                        <ItemsControl ItemsSource="{Binding UnitLines}" ItemTemplate="{StaticResource DetailLineRow}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Theme.Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Cláusula de ajuste" Style="{StaticResource Theme.CardTitle}" />
                    <ItemsControl ItemsSource="{Binding ClauseLines}" ItemTemplate="{StaticResource DetailLineRow}" />
                    <!-- Only under the clause's lines: without a clause there is nothing above it to separate. -->
                    <Separator Margin="0,10" Background="{DynamicResource Theme.Line}">
                        <Separator.Style>
                            <Style TargetType="Separator">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail.Clause}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Separator.Style>
                    </Separator>
                    <TextBlock Text="{Binding NextAdjustmentText}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Theme.Hint}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="La cláusula se puede cambiar hasta el primer ajuste confirmado. El cambio vale desde el próximo ajuste." />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Theme.Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Importes y fechas" Style="{StaticResource Theme.CardTitle}" />
                    <ItemsControl ItemsSource="{Binding AmountLines}" ItemTemplate="{StaticResource DetailLineRow}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Historial de ajustes. -->
        <Border Padding="8,8,8,4" Margin="0,18,0,0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Theme.Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tab}" Value="{x:Static contracts:ContractDetailTab.Adjustments}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="Historial de ajustes" Style="{StaticResource Theme.CardTitle}" Margin="14,10,14,0" />
                <DataGrid Style="{StaticResource Theme.Table}" ItemsSource="{Binding Adjustments.History}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="VENCE · RIGE DESDE" Width="1.2*" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DueDateText}" TextAlignment="Center" />
                                        <TextBlock FontWeight="Bold" TextAlignment="Center">
                                            <Run Text="Rige desde " /><Run Text="{Binding AppliesFromText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ALQUILER" Width="1.2*" MinWidth="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource Theme.Muted}" TextAlignment="Center">
                                            <Run Text="antes " /><Run Text="{Binding PreviousCanonText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding NewCanonText}" FontWeight="Bold" TextAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="COEFICIENTE" Binding="{Binding CoefficientText}" Width="1*" MinWidth="110" />
                        <DataGridTemplateColumn Header="CONFIRMÓ" Width="1.4*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ConfirmedByText}" TextAlignment="Center" TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="DIFERENCIA" Width="1.4*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DifferenceText}" TextAlignment="Center" TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Este contrato todavía no tiene ajustes confirmados." Style="{StaticResource Theme.Hint}"
                           FontSize="15" Margin="14,18"
                           Visibility="{Binding Adjustments.HasNoAdjustments, Converter={StaticResource Shown}}" />
            </StackPanel>
        </Border>

        <!-- Registro de eventos. -->
        <Border Padding="8,8,8,4" Margin="0,18,0,0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Theme.Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tab}" Value="{x:Static contracts:ContractDetailTab.Events}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="Registro de eventos" Style="{StaticResource Theme.CardTitle}" Margin="14,10,14,0" />
                <DataGrid Style="{StaticResource Theme.Table}" ItemsSource="{Binding Events}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CUÁNDO" Binding="{Binding WhenText}" Width="0.8*" MinWidth="110" />
                        <DataGridTemplateColumn Header="EVENTO" Width="1.2*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EventText}" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="MOTIVO" Width="2*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ReasonText}" TextAlignment="Center" TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="QUIÉN" Width="1.2*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding WhoText}" TextAlignment="Center" TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Todavía no hay avisos, fines ni cancelaciones en este contrato." Style="{StaticResource Theme.Hint}"
                           FontSize="15" Margin="14,18"
                           Visibility="{Binding HasNoEvents, Converter={StaticResource Shown}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
