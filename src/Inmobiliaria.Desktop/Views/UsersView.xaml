<UserControl x:Class="Inmobiliaria.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- A band shown only while its binding holds a value: the confirmation and the generated password. -->
        <Style x:Key="ShownWhenSet" TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Actualizar" Padding="12,4" Command="{Binding LoadCommand}" />
                <TextBlock Text="Usuarios" FontSize="18" FontWeight="SemiBold" />
            </DockPanel>

            <GroupBox Header="Nuevo empleado" Margin="0,12,0,0" Padding="8">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="Nombre de usuario" />
                        <TextBox Width="180" Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="Nombre y apellido" />
                        <TextBox Width="240" Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Button Content="Crear" Margin="12,0,0,0" Padding="16,2" VerticalAlignment="Bottom"
                            Command="{Binding CreateCommand}" />
                </StackPanel>
            </GroupBox>

            <TextBlock Text="{Binding RefusalMessage}" TextWrapping="Wrap" Foreground="#FF8A4B00" Margin="0,8,0,0" />
            <TextBlock Text="{Binding Runner.ErrorMessage}" TextWrapping="Wrap" Foreground="#FFB00020" Margin="0,4,0,0" />

            <Border Style="{StaticResource ShownWhenSet}" Tag="{Binding Pending}"
                    BorderBrush="#FF8A4B00" Background="#FFFFF4E5">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Confirmar" Padding="12,2" Command="{Binding ConfirmCommand}" />
                        <Button Content="Cancelar" Padding="12,2" Margin="8,0,0,0" Command="{Binding CancelCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Pending.Text}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource ShownWhenSet}" Tag="{Binding Revealed}"
                    BorderBrush="#FF1B5E20" Background="#FFE8F5E9">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Contraseña provisoria para" />
                        <Run Text="{Binding Revealed.Username, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=". Pásela al empleado: se muestra una sola vez y la tendrá que cambiar al entrar." />
                    </TextBlock>
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Copiar" Padding="12,2" Command="{Binding CopyCommand}" />
                            <Button Content="Listo, ya la pasé" Padding="12,2" Margin="8,0,0,0" Command="{Binding DismissCommand}" />
                        </StackPanel>
                        <TextBox Text="{Binding Revealed.Password, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" FontFamily="Consolas" FontSize="22" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding CopyMessage}" TextWrapping="Wrap" Foreground="#FFB00020" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Usuarios del sistema" FontWeight="SemiBold" Margin="0,12,0,4" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Users}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding DisplayName}" Width="*" />
                <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" />
                <DataGridTextColumn Header="Rol" Binding="{Binding RoleText}" />
                <DataGridTextColumn Header="Estado" Binding="{Binding StateText}" />
                <DataGridTextColumn Header="Contraseña" Binding="{Binding PendingText}" />
                <DataGridTemplateColumn Header="Acciones">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Reiniciar contraseña" Padding="8,0"
                                        Command="{Binding DataContext.ResetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Desactivar" Padding="8,0" Margin="4,0,0,0"
                                        Command="{Binding DataContext.DeactivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Reactivar" Padding="8,0" Margin="4,0,0,0"
                                        Command="{Binding DataContext.ReactivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
