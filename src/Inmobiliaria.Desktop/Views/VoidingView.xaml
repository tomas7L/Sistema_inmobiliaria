<UserControl x:Class="Inmobiliaria.Desktop.Views.VoidingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Inmobiliaria.Desktop.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <!-- Shown only when the bound value is not null; the view decides nothing else. -->
        <Style x:Key="WhenSet" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Anular un cobro" FontSize="18" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Número de cualquiera de los dos recibos: " VerticalAlignment="Center" />
                <TextBox Width="120" Text="{Binding NumberText, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Buscar" Margin="4,0,0,0" Padding="10,2" Command="{Binding FindCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding FindMessage}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding DoneMessage}" FontWeight="SemiBold" Foreground="#FF2E7D32" />
            <TextBlock Text="{Binding Runner.ErrorMessage}" TextWrapping="Wrap" Foreground="#FFB00020" />

            <views:ReciboView DataContext="{Binding Recibo}" Tag="{Binding}" Style="{StaticResource WhenSet}" />

            <TextBlock Text="{Binding Gate.Explanation}" TextWrapping="Wrap" Foreground="#FF8A4B00" Margin="0,8,0,0" />

            <StackPanel Tag="{Binding Recibo}" Style="{StaticResource WhenSet}" Margin="0,8,0,0">
                <TextBlock Text="Motivo de la anulación" />
                <TextBox Text="{Binding ReasonText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                         AcceptsReturn="True" MinHeight="48" />
                <Button Content="Ver la anulación" HorizontalAlignment="Left" Padding="12,4" Margin="0,8,0,0"
                        Command="{Binding PreviewCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding RefusalMessage}" TextWrapping="Wrap" Foreground="#FFB00020" Margin="0,4,0,0" />
            <TextBlock Text="{Binding StaleMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#FF8A4B00" />

            <!-- The voiding preview: what will be reversed, confirmed explicitly. -->
            <Border Tag="{Binding VoidPreview}" Style="{StaticResource WhenSet}"
                    BorderBrush="#FFB00020" BorderThickness="2" Padding="8" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Revise antes de confirmar la anulación" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Corrections}" />
                    <TextBlock Text="{Binding ResultingAmountOwedText, StringFormat='Saldo resultante: {0}'}" />
                    <TextBlock Text="{Binding AnnulmentsText}" />
                    <Button Content="Confirmar anulación" HorizontalAlignment="Left" Padding="12,4" Margin="0,8,0,0"
                            Command="{Binding ConfirmCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
