<UserControl x:Class="Inmobiliaria.Desktop.Views.NoticesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <!-- A working layout only, so the mailbox can be set up and one real notice sent (notificaciones tasks 3.4, 3.7).
         Mateo's layout replaces it in Phase 4; the bindings stay. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Actualizar" Padding="12,4" Command="{Binding LoadCommand}" />
                <TextBlock Text="Avisos de deuda" FontSize="18" FontWeight="SemiBold" />
            </DockPanel>
            <TextBlock Text="{Binding Runner.ErrorMessage}" TextWrapping="Wrap" Foreground="#FFB00020" />

            <!-- Offered to an Admin only: the view-model gives an Empleado none (spec Requirement 8). -->
            <GroupBox Header="Casilla de Gmail" Margin="0,8,0,0" DataContext="{Binding MailboxSetup}">
                <GroupBox.Style>
                    <Style TargetType="GroupBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GroupBox.Style>
                <StackPanel Margin="4">
                    <TextBlock Text="{Binding StoredText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Dirección: " Width="140" VerticalAlignment="Center" />
                        <TextBox Width="260" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Contraseña de aplicación: " Width="140" VerticalAlignment="Center" />
                        <PasswordBox x:Name="AppPasswordInput" Width="260" PasswordChanged="AppPasswordInput_PasswordChanged" />
                        <Button Content="Guardar" Margin="8,0,0,0" Padding="12,2" Command="{Binding SaveCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Runner.ErrorMessage}" TextWrapping="Wrap" Foreground="#FFB00020" />
                </StackPanel>
            </GroupBox>

            <TextBlock Text="Para enviar hoy" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock Text="No hay avisos para enviar hoy.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" HeadersVisibility="Column" MaxHeight="300" Margin="0,4,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Contrato" Binding="{Binding ShortId}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Locatario" Binding="{Binding Tenant}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="Correo" Binding="{Binding Recipient}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalText}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Incluye recargo" Binding="{Binding RecargoText}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Días de atraso" Binding="{Binding DaysOverdue}" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Quitar" Padding="8,0"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Enviar avisos" Padding="12,4" Command="{Binding SendCommand}" />
                <TextBlock Text="{Binding SendUnavailableReason}" Margin="8,0,0,0" VerticalAlignment="Center"
                           TextWrapping="Wrap" Foreground="#FFB00020" />
            </StackPanel>
            <TextBlock Text="{Binding ReportText}" FontWeight="SemiBold" Margin="0,6,0,0" />
            <ItemsControl ItemsSource="{Binding Failures}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#FFB00020" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Sin correo: llamar" FontWeight="SemiBold" Margin="0,12,0,0" />
            <DataGrid ItemsSource="{Binding NoEmail}" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" HeadersVisibility="Column" MaxHeight="200" Margin="0,4,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Contrato" Binding="{Binding ContractShortId}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Locatario" Binding="{Binding Tenant}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="Unidades" Binding="{Binding Units}" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Ya enviados este mes" FontWeight="SemiBold" Margin="0,12,0,0" />
            <DataGrid ItemsSource="{Binding AlreadySent}" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" HeadersVisibility="Column" MaxHeight="200" Margin="0,4,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Contrato" Binding="{Binding ShortId}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Locatario" Binding="{Binding Tenant}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="Enviado por" Binding="{Binding RecordedBy}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Cuándo" Binding="{Binding RecordedAtText}" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
