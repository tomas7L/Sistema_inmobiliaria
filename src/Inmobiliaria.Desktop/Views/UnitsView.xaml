<UserControl x:Class="Inmobiliaria.Desktop.Views.UnitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:units="clr-namespace:Inmobiliaria.Presentation.Units;assembly=Inmobiliaria.Presentation"
             xmlns:domain="clr-namespace:Inmobiliaria.Domain.Units;assembly=Inmobiliaria.Domain"
             xmlns:views="clr-namespace:Inmobiliaria.Desktop.Views"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1100"
             Style="{StaticResource Theme.Page}">
    <!--
        The Propiedades screen as the designer drew it (canvas "Propiedades", "Nueva propiedad", "Editar propiedad"): the
        list, and in its place the form, one step at a time. Bound to UnitsViewModel; no logic lives here.
    -->
    <UserControl.Resources>
        <views:EqualsConverter x:Key="Equals" />
        <views:SetToVisibleConverter x:Key="Set" />
        <BooleanToVisibilityConverter x:Key="Shown" />

        <!-- Shown only while the form is closed. -->
        <Style x:Key="ListPart" TargetType="Grid">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFormOpen}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The type is chosen while creating, and shown locked while correcting. -->
        <Style x:Key="TypeChoice" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanChooseType}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TypeLocked" TargetType="DockPanel">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanChooseType}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The canvas's .alert: a coloured band with an icon and its text. Tag picks the colour: "bad", "warn" or "ok". -->
        <Style x:Key="Notice" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Line}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Ink2}" />
            <Setter Property="TextElement.FontSize" Value="14" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="bad">
                    <Setter Property="Background" Value="{DynamicResource Theme.BadBack}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Bad}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Bad}" />
                </Trigger>
                <Trigger Property="Tag" Value="warn">
                    <Setter Property="Background" Value="{DynamicResource Theme.WarnBack}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Warn}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Warn}" />
                </Trigger>
                <Trigger Property="Tag" Value="ok">
                    <Setter Property="Background" Value="{DynamicResource Theme.OkBack}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Ok}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Ok}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A notice's icon, drawn on the canvas's 24 x 24 grid in the notice's own colour. -->
        <Style x:Key="NoticeIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            <Setter Property="StrokeThickness" Value="1.9" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>

        <!-- The canvas's .btn-lg, for the form's last buttons. -->
        <Style x:Key="LargeGhost" TargetType="Button" BasedOn="{StaticResource Theme.GhostButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="26,0" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="LargePrimary" TargetType="Button" BasedOn="{StaticResource Theme.PrimaryButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="26,0" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <!-- The canvas's .btn-primary.btn-sm, inside a notice. -->
        <Style x:Key="SmallPrimary" TargetType="Button" BasedOn="{StaticResource Theme.PrimaryButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- The fields and the save buttons stay in view until something is saved, the warning included, as on the
             canvas: editing a field withdraws the warning (UnitsViewModel.WithdrawWarning). -->
        <Style x:Key="FieldsPart" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step}" Value="{x:Static units:UnitFormStep.Saved}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SavedStep" TargetType="Border" BasedOn="{StaticResource Notice}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step}" Value="{x:Static units:UnitFormStep.Saved}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Required" TargetType="Run">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Bad}" />
        </Style>
    </UserControl.Resources>

    <!-- The canvas's 1536 x 785 fit: the page never scrolls, the table scrolls inside its card. -->
    <Grid Margin="32,20,32,16">

            <!-- The list. -->
            <Grid Style="{StaticResource ListPart}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Propiedades" Style="{StaticResource Theme.Title}" />
                <TextBlock Grid.Row="1" Text="Inmuebles y cocheras que se alquilan. Solo datos físicos y dirección." Style="{StaticResource Theme.Subtitle}" />
                <TextBlock Grid.Row="2" Text="{Binding Runner.ErrorMessage}" Style="{StaticResource Theme.ErrorText}" Margin="0,12,0,0" />

                <Border Grid.Row="3" Style="{StaticResource Theme.Card}" CornerRadius="22" Padding="16,12" Margin="0,12,0,0">
                    <!-- The search box takes what the buttons leave, to the card's right edge, as on the canvas. -->
                    <DockPanel LastChildFill="True">
                        <Button Content="Nueva propiedad" Style="{StaticResource Theme.PrimaryButton}" DockPanel.Dock="Left"
                                Command="{Binding NewCommand}" Margin="0,4,0,4" />
                        <Button Content="Editar" Style="{StaticResource Theme.GhostButton}" Margin="12,0,0,0" DockPanel.Dock="Left"
                                Command="{Binding EditCommand}" CommandParameter="{Binding SelectedUnit}" />
                        <Border Style="{StaticResource Theme.SegmentGroup}" Margin="12,4,0,4" DockPanel.Dock="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Todas" GroupName="TypeFilter" Style="{StaticResource Theme.Segment}"
                                             IsChecked="{Binding TypeFilter, Converter={StaticResource Equals}, ConverterParameter={x:Null}}" />
                                <RadioButton Content="Propiedades" GroupName="TypeFilter" Style="{StaticResource Theme.Segment}"
                                             IsChecked="{Binding TypeFilter, Converter={StaticResource Equals}, ConverterParameter={x:Static domain:UnitType.Property}}" />
                                <RadioButton Content="Cocheras" GroupName="TypeFilter" Style="{StaticResource Theme.Segment}"
                                             IsChecked="{Binding TypeFilter, Converter={StaticResource Equals}, ConverterParameter={x:Static domain:UnitType.ParkingSpace}}" />
                            </StackPanel>
                        </Border>
                        <TextBox Style="{StaticResource Theme.Input}" Margin="12,4,0,4" MinWidth="220" Tag="Buscar por dirección"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Theme.Card}" Padding="8,8,8,4" Margin="0,12,0,0"
                        VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- The canvas's "compact" table: Theme.TableCell's 10,14 already is its cell padding. -->
                        <DataGrid Style="{StaticResource Theme.Table}" ItemsSource="{Binding Units}"
                                  SelectedItem="{Binding SelectedUnit}" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="TIPO" Width="1*" MinWidth="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Chip" Style="{StaticResource Theme.Chip}" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding TypeText}" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsParking}" Value="True">
                                                    <Setter TargetName="Chip" Property="Tag" Value="warn" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="DIRECCIÓN" Width="2*" MinWidth="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StreetText}" FontWeight="Bold" TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="PISO" Binding="{Binding FloorText}" Width="0.7*" MinWidth="60" />
                                <DataGridTextColumn Header="DEPTO" Binding="{Binding ApartmentText}" Width="0.7*" MinWidth="70" />
                                <DataGridTextColumn Header="LOCALIDAD" Binding="{Binding City}" Width="1.2*" MinWidth="100" />
                                <DataGridTextColumn Header="PROVINCIA" Binding="{Binding Province}" Width="1.2*" MinWidth="100" />
                                <DataGridTextColumn Header="CP" Binding="{Binding PostalCode}" Width="0.6*" MinWidth="60" />
                                <DataGridTemplateColumn Header="DISPONIBILIDAD" Width="2*" MinWidth="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Chip" Style="{StaticResource Theme.Chip}" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding AvailabilityText}" TextWrapping="Wrap" TextAlignment="Center" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                    <Setter TargetName="Chip" Property="Tag" Value="ok" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="1" Text="No hay ninguna propiedad con ese filtro." Style="{StaticResource Theme.Hint}"
                                   FontSize="15" Margin="14,18"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource Shown}}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource Theme.Hint}" Margin="14,10,14,14" TextWrapping="Wrap">
                            <Run Text="{Binding CountText, Mode=OneWay}" /><Run Text=". «Disponible» significa que ningún contrato vigente la cubre: se calcula, no se guarda. El tipo no se puede cambiar después de crear la unidad." />
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <!-- The form, in place of the list. It scrolls only on a screen smaller than the canvas's. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsFormOpen, Converter={StaticResource Shown}}">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" Style="{StaticResource Theme.Title}" />
                <TextBlock Text="{Binding FormSubtitle}" Style="{StaticResource Theme.Subtitle}" />
                <!-- The canvas's back link: a small ghost button with its chevron, under the title on the left. -->
                <Button Style="{StaticResource Theme.SmallGhostButton}" Padding="10,0,14,0" HorizontalAlignment="Left"
                        Margin="0,12,0,0" Command="{Binding BackCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M15,6 L9,12 L15,18" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Volver a propiedades" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding Runner.ErrorMessage}" Style="{StaticResource Theme.ErrorText}" Margin="0,12,0,0" />

                <!-- The fields, each with its own error beside it, under one summary (spec Requirement 27). -->
                <StackPanel Style="{StaticResource FieldsPart}">
                    <!-- Tipo and Dirección side by side, as the canvas's "pgrid2": minmax(320px, 1fr) and 2.4fr, gap 16. -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="320" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="2.4*" />
                        </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Theme.Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Tipo" Style="{StaticResource Theme.CardTitle}" />
                            <StackPanel Style="{StaticResource TypeChoice}">
                                <Border Style="{StaticResource Theme.SegmentGroup}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Propiedad" GroupName="UnitType" Style="{StaticResource Theme.Segment}"
                                                     IsChecked="{Binding SelectedType, Converter={StaticResource Equals}, ConverterParameter={x:Static domain:UnitType.Property}}" />
                                        <RadioButton Content="Cochera" GroupName="UnitType" Style="{StaticResource Theme.Segment}"
                                                     IsChecked="{Binding SelectedType, Converter={StaticResource Equals}, ConverterParameter={x:Static domain:UnitType.ParkingSpace}}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Propiedad: casa, departamento o local. Cochera: lugar para estacionar. No se cambia después de cargada."
                                           Style="{StaticResource Theme.Hint}" Margin="0,12,0,0" />
                            </StackPanel>
                            <!-- The note wraps beside the chip: at 1536 a single line was clipped by the card. -->
                            <DockPanel Style="{StaticResource TypeLocked}">
                                <Border Style="{StaticResource Theme.Chip}" Margin="0" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TypeText}" />
                                </Border>
                                <TextBlock Text="El tipo no se cambia después de cargada la unidad." Style="{StaticResource Theme.Hint}"
                                           VerticalAlignment="Center" Margin="14,0,0,0" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Theme.Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Dirección" Style="{StaticResource Theme.CardTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Two per row, then three, as the canvas's ".row" of ".fld" lays them out. -->
                                <Grid Grid.Row="0" Grid.ColumnSpan="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource Theme.Label}"><Run Text="Calle " /><Run Text="*" Style="{StaticResource Required}" /></TextBlock>
                                        <TextBox Style="{StaticResource Theme.Input}" Tag="Por ejemplo: Sarmiento"
                                                 Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}"
                                                 views:FieldError.Text="{Binding Errors[Street]}" />
                                        <TextBlock Text="{Binding Errors[Street]}" Style="{StaticResource Theme.ErrorText}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource Theme.Label}"><Run Text="Número " /><Run Text="*" Style="{StaticResource Required}" /></TextBlock>
                                        <TextBox Style="{StaticResource Theme.Input}" Tag="Por ejemplo: 201 o S/N"
                                                 Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                                                 views:FieldError.Text="{Binding Errors[Number]}" />
                                        <TextBlock Text="{Binding Errors[Number]}" Style="{StaticResource Theme.ErrorText}" Margin="0,6,0,0" />
                                        <!-- Hidden while the error already says it. -->
                                        <TextBlock Text="Si no tiene, escriba S/N." Style="{StaticResource Theme.Hint}" Margin="0,6,0,0"
                                                   Visibility="{Binding Errors[Number], Converter={StaticResource Set}, ConverterParameter=invert}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2" Grid.ColumnSpan="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Piso" Style="{StaticResource Theme.Label}" />
                                        <TextBox Style="{StaticResource Theme.Input}" Tag="Por ejemplo: PB o 1°"
                                                 Text="{Binding Floor, UpdateSourceTrigger=PropertyChanged}"
                                                 views:FieldError.Text="{Binding Errors[Floor]}" />
                                        <TextBlock Text="{Binding Errors[Floor]}" Style="{StaticResource Theme.ErrorText}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Departamento o local" Style="{StaticResource Theme.Label}" />
                                        <TextBox Style="{StaticResource Theme.Input}" Tag="Por ejemplo: Dpto A o Local 3"
                                                 Text="{Binding Apartment, UpdateSourceTrigger=PropertyChanged}"
                                                 views:FieldError.Text="{Binding Errors[Apartment]}" />
                                        <TextBlock Text="{Binding Errors[Apartment]}" Style="{StaticResource Theme.ErrorText}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="4" Grid.Column="0">
                                    <TextBlock Style="{StaticResource Theme.Label}"><Run Text="Localidad " /><Run Text="*" Style="{StaticResource Required}" /></TextBlock>
                                    <TextBox Style="{StaticResource Theme.Input}" Tag="Por ejemplo: Sunchales"
                                             Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                                             views:FieldError.Text="{Binding Errors[City]}" />
                                    <TextBlock Text="{Binding Errors[City]}" Style="{StaticResource Theme.ErrorText}" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="2">
                                    <TextBlock Style="{StaticResource Theme.Label}"><Run Text="Provincia " /><Run Text="*" Style="{StaticResource Required}" /></TextBlock>
                                    <ComboBox Style="{StaticResource Theme.Dropdown}" ItemsSource="{Binding Provinces}"
                                              SelectedItem="{Binding Province}" views:FieldError.Text="{Binding Errors[Province]}" />
                                    <TextBlock Text="{Binding Errors[Province]}" Style="{StaticResource Theme.ErrorText}" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="4">
                                    <TextBlock Style="{StaticResource Theme.Label}"><Run Text="Código postal " /><Run Text="*" Style="{StaticResource Required}" /></TextBlock>
                                    <TextBox Style="{StaticResource Theme.Input}" Tag="2322 o S2322ABC"
                                             Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}"
                                             views:FieldError.Text="{Binding Errors[PostalCode]}" />
                                    <TextBlock Text="{Binding Errors[PostalCode]}" Style="{StaticResource Theme.ErrorText}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding RefusalMessage}" Style="{StaticResource Theme.ErrorText}" Margin="0,12,0,0" />
                            <TextBlock Text="Los datos del alquiler (inquilino, precio, fechas) no se guardan en la unidad: están en el contrato."
                                       Style="{StaticResource Theme.Hint}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                    </Grid>

                    <!-- The summary, under the cards on this screen's canvas (spec Requirement 27). -->
                    <Border Style="{StaticResource Notice}" Tag="bad" Margin="0,12,0,0"
                            Visibility="{Binding Errors.Summary, Converter={StaticResource Set}}">
                        <DockPanel>
                            <Viewbox Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource NoticeIcon}" Data="M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M12,7.5 V12.5 M12,16 V16.5" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding Errors.Summary}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Another unit has this address: proceed or go back to the fields. -->
                    <Border Style="{StaticResource Notice}" Tag="warn" Margin="0,12,0,0"
                            Visibility="{Binding IdenticalAddressWarning, Converter={StaticResource Set}}">
                        <DockPanel>
                            <Viewbox Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center" DockPanel.Dock="Left">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource NoticeIcon}" Data="M12,3 L22,21 H2 Z M12,10 V15 M12,18 V18.5" />
                                </Canvas>
                            </Viewbox>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Button Content="Volver a revisar" Style="{StaticResource Theme.SmallGhostButton}" Command="{Binding CancelCommand}" />
                                <Button Content="Guardarla igual" Style="{StaticResource SmallPrimary}" Margin="10,0,0,0"
                                        Command="{Binding AcceptIdenticalAddressCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding IdenticalAddressWarning}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancelar" Style="{StaticResource LargeGhost}" Command="{Binding BackCommand}" />
                        <Button Content="{Binding SaveText}" Style="{StaticResource LargePrimary}" Margin="12,0,0,0"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- What was saved, with the way back. -->
                <Border Style="{StaticResource SavedStep}" Tag="ok" Padding="20,16" Margin="0,12,0,0">
                    <DockPanel>
                        <Viewbox Width="26" Height="26" Margin="0,0,14,0" VerticalAlignment="Center" DockPanel.Dock="Left">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource NoticeIcon}" StrokeThickness="1.8"
                                      Data="M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M8,12.5 L11,15.5 L16,9.5" />
                            </Canvas>
                        </Viewbox>
                        <Button Content="Volver a propiedades" Style="{StaticResource Theme.PrimaryButton}" DockPanel.Dock="Right"
                                VerticalAlignment="Center" Margin="14,0,0,0" Command="{Binding BackCommand}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Saved.Title}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Theme.Ink}"
                                       Margin="0,0,0,2" />
                            <TextBlock Text="{Binding Saved.Text}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
    </Grid>
</UserControl>
