<Application x:Class="Inmobiliaria.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Inmobiliaria.Desktop"
             ShutdownMode="OnExplicitShutdown">
    <!-- No StartupUri: App.xaml.cs's OnStartup drives LoginWindow -> (forced) ChangePasswordWindow
         -> MainWindow itself (design Decision 10). A StartupUri here would let WPF construct a
         window before authentication, which spec "No Database Access Before Authentication"
         forbids in spirit even for a window that does nothing yet. -->
    <Application.Resources>

    </Application.Resources>
</Application>
