<Window x:Class="Inmobiliaria.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Inmobiliaria.Desktop"
        xmlns:views="clr-namespace:Inmobiliaria.Desktop.Views"
        xmlns:shell="clr-namespace:Inmobiliaria.Presentation.Shell;assembly=Inmobiliaria.Presentation"
        mc:Ignorable="d"
        Title="Sistema Inmobiliaria" Height="450" Width="800">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8" Background="#FFEFEFEF">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                <TextBlock Text=" - " />
                <TextBlock Text="{Binding RoleText}" />
            </StackPanel>
        </Border>

        <ItemsControl DockPanel.Dock="Top"
                      ItemsSource="{Binding SettingsProblems}"
                      Margin="12,8,12,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#FFB00020" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ListBox x:Name="NavigationList"
                 ItemsSource="{Binding Navigation}"
                 DisplayMemberPath="Title"
                 Width="220"
                 DockPanel.Dock="Left"
                 Margin="12">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                    <Setter Property="ToolTip" Value="{Binding UnavailableReason}" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- The screen of the selected entry. Chosen by triggers on the selection, so no code decides it. -->
        <Grid>
            <TextBlock Text="Sistema Inmobiliaria"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="24">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.GoLive}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <views:GoLiveView x:Name="GoLiveScreen">
                <views:GoLiveView.Style>
                    <Style TargetType="views:GoLiveView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.GoLive}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:GoLiveView.Style>
            </views:GoLiveView>
        </Grid>
    </DockPanel>
</Window>
