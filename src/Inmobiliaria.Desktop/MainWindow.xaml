<Window x:Class="Inmobiliaria.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Inmobiliaria.Desktop"
        xmlns:views="clr-namespace:Inmobiliaria.Desktop.Views"
        xmlns:shell="clr-namespace:Inmobiliaria.Presentation.Shell;assembly=Inmobiliaria.Presentation"
        mc:Ignorable="d"
        Title="Sistema Inmobiliaria" Height="450" Width="800">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8" Background="#FFEFEFEF">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                <TextBlock Text=" - " />
                <TextBlock Text="{Binding RoleText}" />
            </StackPanel>
        </Border>

        <ItemsControl DockPanel.Dock="Top"
                      ItemsSource="{Binding SettingsProblems}"
                      Margin="12,8,12,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#FFB00020" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The sidebar: the screens, and Cerrar sesión at its foot (12.3d). -->
        <DockPanel DockPanel.Dock="Left" Width="220" Margin="12">
            <Button DockPanel.Dock="Bottom"
                    Content="{Binding LogOutText}"
                    Command="{Binding LogOutCommand}"
                    HorizontalAlignment="Stretch"
                    Padding="12,4"
                    Margin="0,8,0,0" />
            <!-- Asked only with work pending on a screen (12.3d, Tomás 2026-11-16). -->
            <Border DockPanel.Dock="Bottom" BorderBrush="#FFB00020" BorderThickness="1" Padding="8" Margin="0,8,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LogOutWarning}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding LogOutWarning}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Cerrar sesión" Command="{Binding ConfirmLogOutCommand}" Padding="8,2" />
                        <Button Content="Cancelar" Command="{Binding CancelLogOutCommand}" Padding="8,2" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <ListBox x:Name="NavigationList"
                     ItemsSource="{Binding Navigation}"
                     DisplayMemberPath="Title">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                        <Setter Property="ToolTip" Value="{Binding UnavailableReason}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

        <!-- The screen of the selected entry. Chosen by triggers on the selection, so no code decides it. -->
        <Grid>
            <TextBlock Text="Sistema Inmobiliaria"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="24">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.GoLive}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.CashDesk}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.RecentCollections}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Voiding}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Users}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Notices}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Parties}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <views:RecentCollectionsView x:Name="RecentCollectionsViewScreen">
                <views:RecentCollectionsView.Style>
                    <Style TargetType="views:RecentCollectionsView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.RecentCollections}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:RecentCollectionsView.Style>
            </views:RecentCollectionsView>

            <views:VoidingView x:Name="VoidingViewScreen">
                <views:VoidingView.Style>
                    <Style TargetType="views:VoidingView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Voiding}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:VoidingView.Style>
            </views:VoidingView>

            <views:CashDeskView x:Name="CashDeskScreen">
                <views:CashDeskView.Style>
                    <Style TargetType="views:CashDeskView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.CashDesk}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:CashDeskView.Style>
            </views:CashDeskView>

            <views:GoLiveView x:Name="GoLiveScreen">
                <views:GoLiveView.Style>
                    <Style TargetType="views:GoLiveView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.GoLive}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:GoLiveView.Style>
            </views:GoLiveView>

            <views:NoticesView x:Name="NoticesScreen">
                <views:NoticesView.Style>
                    <Style TargetType="views:NoticesView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Notices}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:NoticesView.Style>
            </views:NoticesView>

            <!-- Rebuilt to the designer's canvas, so its style is based on the theme's page. -->
            <views:PartiesView x:Name="PartiesScreen">
                <views:PartiesView.Style>
                    <Style TargetType="views:PartiesView" BasedOn="{StaticResource Theme.Page}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Parties}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:PartiesView.Style>
            </views:PartiesView>

            <views:UnitsView x:Name="UnitsScreen">
                <views:UnitsView.Style>
                    <Style TargetType="views:UnitsView" BasedOn="{StaticResource Theme.Page}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Units}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:UnitsView.Style>
            </views:UnitsView>

            <views:IndicesView x:Name="IndicesScreen">
                <views:IndicesView.Style>
                    <Style TargetType="views:IndicesView" BasedOn="{StaticResource Theme.Page}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Indices}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:IndicesView.Style>
            </views:IndicesView>

            <views:UsersView x:Name="UsersScreen">
                <views:UsersView.Style>
                    <Style TargetType="views:UsersView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Users}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:UsersView.Style>
            </views:UsersView>
        </Grid>
    </DockPanel>
</Window>
