<Window x:Class="Inmobiliaria.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Inmobiliaria.Desktop"
        xmlns:views="clr-namespace:Inmobiliaria.Desktop.Views"
        xmlns:shell="clr-namespace:Inmobiliaria.Presentation.Shell;assembly=Inmobiliaria.Presentation"
        mc:Ignorable="d"
        Title="Sistema Inmobiliaria" Height="450" Width="800">
    <Window.Resources>
        <views:NavigationIconConverter x:Key="NavIcon" />
        <views:UpperCaseConverter x:Key="Upper" />

        <!-- The entries grouped under the canvas's headings; the grouping is the entry's own (NavigationEntry.Group). -->
        <CollectionViewSource x:Key="GroupedNavigation" Source="{Binding Navigation}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- One entry as the canvas's ".ni": a pill holding the icon in its circle and the name. -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
            <Setter Property="ToolTip" Value="{Binding UnavailableReason}" />
            <!-- Without this a disabled entry never shows why: Windows hides the tooltip of what is disabled. -->
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Pill" CornerRadius="18" Padding="4,4,14,4" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Circle" Width="28" Height="28" CornerRadius="14" BorderThickness="1"
                                        Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Line}">
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="Icon" Data="{Binding Target, Converter={StaticResource NavIcon}}"
                                                  Stroke="{DynamicResource Theme.Ink2}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock x:Name="Name" Text="{Binding Title}" FontSize="14" FontWeight="Medium"
                                           Foreground="{DynamicResource Theme.Ink}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{DynamicResource Theme.Select}" />
                                <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Theme.NavOn}" />
                            </Trigger>
                            <!-- The canvas's aria-current: the menu's blue, white words. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Theme.NavOn}" />
                                <Setter TargetName="Name" Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="Name" Property="FontWeight" Value="Bold" />
                                <Setter TargetName="Circle" Property="Background" Value="#33FFFFFF" />
                                <Setter TargetName="Circle" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="Icon" Property="Stroke" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cerrar sesión, at the foot: an entry like the others that opens nothing. -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="18" Padding="4,4,14,4" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Circle" Width="28" Height="28" CornerRadius="14" BorderThickness="1"
                                        Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Line}">
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="Icon" Data="{Binding Converter={StaticResource NavIcon}, ConverterParameter=logout}"
                                                  Stroke="{DynamicResource Theme.Ink2}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" Margin="12,0,0,0" TextElement.FontSize="14"
                                                  TextElement.FontWeight="Medium" TextElement.Foreground="{DynamicResource Theme.Ink}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{DynamicResource Theme.Select}" />
                                <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Theme.NavOn}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Theme.Ink}" />
                                <Setter TargetName="Pill" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Background="{DynamicResource Theme.Background}" TextElement.FontFamily="{StaticResource Theme.Font}">
        <!-- The canvas's sidebar (".side", 268 wide at 1536 x 785): the logo, the screens by group, Cerrar sesión at its foot. -->
        <Border DockPanel.Dock="Left" Width="268" Padding="14,12,14,10" Background="{DynamicResource Theme.Surface2}"
                BorderBrush="{DynamicResource Theme.Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Theme.Card}" Padding="10,8" Margin="0,0,0,2">
                    <Image Source="pack://siteoforigin:,,,/Assets/agency-logo.png" Width="70" Height="70"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Content="{Binding LogOutText}"
                        Command="{Binding LogOutCommand}" Margin="0,8,0,0" />
                <!-- Asked only with work pending on a screen (12.3d, Tomás 2026-11-16). -->
                <Border DockPanel.Dock="Bottom" CornerRadius="14" Padding="12,10" Margin="0,8,0,0" BorderThickness="1"
                        Background="{DynamicResource Theme.WarnBack}" BorderBrush="{DynamicResource Theme.Warn}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LogOutWarning}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding LogOutWarning}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Theme.Warn}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Cerrar sesión" Style="{StaticResource Theme.SmallGhostButton}" Command="{Binding ConfirmLogOutCommand}" />
                            <Button Content="Cancelar" Style="{StaticResource Theme.SmallGhostButton}" Command="{Binding CancelLogOutCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ListBox x:Name="NavigationList" ItemsSource="{Binding Source={StaticResource GroupedNavigation}}"
                         ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <!-- WPF's own group indents its entries by 5; this one does not. -->
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel>
                                                    <ContentPresenter />
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                            <!-- The canvas's ".grp": a small, bold, muted heading in capitals. -->
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name, Converter={StaticResource Upper}}" FontSize="11.5" FontWeight="Bold"
                                               Foreground="{DynamicResource Theme.Muted}" Margin="12,10,12,3" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Configuration problems found at startup, as a red notice over the screens. -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SettingsProblems}" Margin="32,12,32,0">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SettingsProblems.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="14" Padding="14,10" Margin="0,0,0,6" BorderThickness="1"
                            Background="{DynamicResource Theme.BadBack}" BorderBrush="{DynamicResource Theme.Bad}">
                        <DockPanel>
                            <Viewbox Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M12,7.5 V12.5 M12,16 V16.5" Stroke="{DynamicResource Theme.Bad}"
                                          StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Bad}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The screen of the selected entry. Chosen by triggers on the selection, so no code decides it. -->
        <Grid>
            <TextBlock Text="Sistema Inmobiliaria"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="24">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.GoLive}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.CashDesk}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.RecentCollections}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Voiding}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Users}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Notices}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Parties}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Contracts}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Adjustments}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <views:RecentCollectionsView x:Name="RecentCollectionsViewScreen">
                <views:RecentCollectionsView.Style>
                    <Style TargetType="views:RecentCollectionsView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.RecentCollections}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:RecentCollectionsView.Style>
            </views:RecentCollectionsView>

            <views:VoidingView x:Name="VoidingViewScreen">
                <views:VoidingView.Style>
                    <Style TargetType="views:VoidingView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Voiding}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:VoidingView.Style>
            </views:VoidingView>

            <views:CashDeskView x:Name="CashDeskScreen">
                <views:CashDeskView.Style>
                    <Style TargetType="views:CashDeskView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.CashDesk}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:CashDeskView.Style>
            </views:CashDeskView>

            <views:GoLiveView x:Name="GoLiveScreen">
                <views:GoLiveView.Style>
                    <Style TargetType="views:GoLiveView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.GoLive}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:GoLiveView.Style>
            </views:GoLiveView>

            <views:NoticesView x:Name="NoticesScreen">
                <views:NoticesView.Style>
                    <Style TargetType="views:NoticesView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Notices}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:NoticesView.Style>
            </views:NoticesView>

            <!-- Rebuilt to the designer's canvas, so its style is based on the theme's page. -->
            <views:ContractsView x:Name="ContractsScreen">
                <views:ContractsView.Style>
                    <Style TargetType="views:ContractsView" BasedOn="{StaticResource Theme.Page}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Contracts}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:ContractsView.Style>
            </views:ContractsView>

            <views:PartiesView x:Name="PartiesScreen">
                <views:PartiesView.Style>
                    <Style TargetType="views:PartiesView" BasedOn="{StaticResource Theme.Page}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Parties}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:PartiesView.Style>
            </views:PartiesView>

            <views:UnitsView x:Name="UnitsScreen">
                <views:UnitsView.Style>
                    <Style TargetType="views:UnitsView" BasedOn="{StaticResource Theme.Page}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Units}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:UnitsView.Style>
            </views:UnitsView>

            <views:IndicesView x:Name="IndicesScreen">
                <views:IndicesView.Style>
                    <Style TargetType="views:IndicesView" BasedOn="{StaticResource Theme.Page}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Indices}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:IndicesView.Style>
            </views:IndicesView>

            <views:AdjustmentsView x:Name="AdjustmentsScreen">
                <views:AdjustmentsView.Style>
                    <Style TargetType="views:AdjustmentsView" BasedOn="{StaticResource Theme.Page}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Adjustments}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:AdjustmentsView.Style>
            </views:AdjustmentsView>

            <views:UsersView x:Name="UsersScreen">
                <views:UsersView.Style>
                    <Style TargetType="views:UsersView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                         Value="{x:Static shell:NavigationTarget.Users}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:UsersView.Style>
            </views:UsersView>

            <!-- The canvas's ".usr": the user's name and role, at the top right, level with the title. Only over the screens
                 already drawn to the canvas, whose top right is kept free for it; an older screen has its own controls
                 there (Usuarios' "Actualizar") and gains it when it is redrawn. -->
            <TextBlock Text="{Binding HeaderText}" FontSize="14" Foreground="{DynamicResource Theme.Muted}"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,32,0" Panel.ZIndex="1"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                     Value="{x:Static shell:NavigationTarget.Contracts}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                     Value="{x:Static shell:NavigationTarget.Parties}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                     Value="{x:Static shell:NavigationTarget.Units}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                     Value="{x:Static shell:NavigationTarget.Indices}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedItem.Target, ElementName=NavigationList}"
                                     Value="{x:Static shell:NavigationTarget.Adjustments}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</Window>
