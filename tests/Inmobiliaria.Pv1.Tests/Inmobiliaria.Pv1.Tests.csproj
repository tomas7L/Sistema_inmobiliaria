<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PV1 (cobranza-y-recibos, human follow-up H.5): Tests 17, 31 and 70 run once against a real, throwaway
    Supabase project through the Supavisor SESSION pooler (port 5432).

    Deliberately NOT part of Inmobiliaria.sln, Inmobiliaria.Core.slnf or CI: the house rule is "0 skipped"
    on `dotnet test Inmobiliaria.sln`, and this project skips unless INMOBILIARIA_PV1_DB is set.

    It cannot reference Inmobiliaria.Infrastructure.Tests (the desk world and the scenarios are internal
    there), so it compiles the two files below as links. PV1 is defined so that the Testcontainers-backed
    parts of those files are left out and nothing here needs Docker.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);PV1</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Inmobiliaria.Domain\Inmobiliaria.Domain.csproj" />
    <ProjectReference Include="..\..\src\Inmobiliaria.Infrastructure\Inmobiliaria.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Inmobiliaria.Infrastructure.Tests\CollectionDeskFixture.cs" Link="Shared\CollectionDeskFixture.cs" />
    <Compile Include="..\Inmobiliaria.Infrastructure.Tests\CollectionDeskConcurrencyTests.cs" Link="Shared\CollectionDeskConcurrencyTests.cs" />
  </ItemGroup>

</Project>
